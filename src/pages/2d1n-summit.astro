---
import Layout from "../layouts/Layout.astro";
import PackageDetailFrame from "../components/PackageDetailFrame.astro";
import { site, whatsappLink } from "../data/site";

const title = "Mount Rinjani Summit Trekking - 2 Days 1 Night";
const bookingHref = whatsappLink(
  "Hello Asgard Rinjani Trekking, I would like to enquire about the Mount Rinjani Summit Trekking - 2 Days 1 Night. Please share current availability, the confirmed itinerary, difficulty guidance, and package details.",
);

const highlights = [
  "A two-day, one-night journey focused on Mount Rinjani's summit route",
  "A high mountain ascent and overnight camp; route and campsite to be confirmed",
  "Panoramic views when weather and visibility allow",
];

const itinerary = [
  {
    day: "Day 0",
    title: "Arrival in Senaru & Pre-Trek Preparation",
    intro: "Day 0 is reserved for arriving in Senaru and preparing for the Senaru Crater Rim trek. The pick-up schedule and estimated transfer times below can help you plan your journey; please confirm with Asgard Rinjani Trekking whether transport from your location is included in your booking and coordinate the arrangements with the team. Pre-trek accommodation in Senaru is not included in the package price, so please arrange your own stay unless separate arrangements have been confirmed.",
    pickupSchedule: [
      { location: "Kuta Lombok", time: "09:00 AM or 04:00–05:00 PM" },
      { location: "Senggigi / Mataram", time: "10:00–11:00 AM or 04:00 PM" },
      { location: "Tetebatu / Pringgasela", time: "09:00–10:00 AM" },
      { location: "Bangsal Harbor / Gili Islands", time: "Around 11:30 AM (following your boat arrival)" },
    ],
    recommendation: "If a morning transfer is available and included in your confirmed booking, we recommend choosing it where possible. This allows time to relax, explore Senaru Village and rest before the trek.",
    transferTimes: [
      { location: "Lombok International Airport (LOP) / Lembar Harbor", time: "Approximately 3.5 hours" },
      { location: "Mataram / Senggigi", time: "Approximately 2 hours" },
      { location: "Bangsal Harbor", time: "Approximately 1 hour 25 minutes" },
      { location: "Kuta Lombok / Tetebatu", time: "Approximately 4 hours" },
      { location: "Labuan Lombok (Kayangan Harbor)", time: "Approximately 2 hours" },
    ],
    accommodation: "Pre-trek accommodation in Senaru is not included in the trekking package price. Guests are responsible for arranging their own stay unless separate arrangements have been made. If included in your confirmed package, the evening preparation may include a trekking guide briefing, equipment inspection and overview of the adventure; coordinate the details with the team.",
    details: [
    ],
    summary: [],
  },
  {
    day: "Day 1",
    title: "Day 1: Senaru to Sembalun Village – Sembalun Crater Rim",
    paragraphs: [
      'Your Mount Rinjani adventure with <strong>Asgard Rinjani Trekking</strong> begins with a morning meeting with our trekking team in Senaru. At approximately <strong>7:00 AM</strong>, you will depart for Sembalun Village, the starting point of your trekking adventure. The transfer takes approximately <strong>45–60 minutes</strong>.',
      "Upon arrival, you will complete the registration process at the Mount Rinjani National Park entrance. After a short briefing with your guide, the trek begins across the beautiful Sembalun savanna, surrounded by wide grasslands and spectacular mountain scenery.",
      "The first section of the trail is relatively gradual as you pass several trekking posts:",
      'After lunch, the trail becomes increasingly steep as you begin the challenging ascent toward <strong>Sembalun Crater Rim (2,639 m)</strong>. The final section involves a long uphill climb with several switchbacks. Your guide will help maintain a comfortable pace with regular rest stops along the way.',
      'Upon reaching the crater rim, the Asgard Rinjani Trekking porter team will prepare your campsite and camping facilities. Take time to relax and enjoy breathtaking views of <strong>Segara Anak Lake, the surrounding mountains, and the spectacular sunset</strong>.',
      "In the evening, enjoy a freshly prepared dinner from your trekking team before settling into your tent for an overnight stay at Sembalun Crater Rim.",
      'Get some rest because the highlight of your adventure awaits early tomorrow morning: the ascent to <strong>Mount Rinjani Summit (3,726 m)</strong>.',
    ],
    stops: [
      { name: "Sembalun Village", detail: "Starting point of the trek." },
      { name: "Pos 1", detail: "Short rest and refreshment break." },
      { name: "Pos 2", detail: "Continue trekking through the open savanna." },
      { name: "Pos 3", detail: "Lunch break and a longer rest." },
    ],
    timeline: [
      { time: "7:00 AM", text: "Your Mount Rinjani adventure with <strong>Asgard Rinjani Trekking</strong> begins with a morning meeting with our trekking team in Senaru. At approximately 7:00 AM, you will depart for Sembalun Village, the starting point of your trekking adventure." },
      { time: "45–60 minutes", text: "The transfer takes approximately 45–60 minutes. Upon arrival, you will complete the registration process at the Mount Rinjani National Park entrance." },
      { time: "After a short briefing", text: "After a short briefing with your guide, the trek begins across the beautiful Sembalun savanna, surrounded by wide grasslands and spectacular mountain scenery." },
      { time: "Pos 1", text: "Short rest and refreshment break." },
      { time: "Pos 2", text: "Continue trekking through the open savanna." },
      { time: "Pos 3", text: "Lunch break and a longer rest." },
      { time: "After lunch", text: "After lunch, the trail becomes increasingly steep as you begin the challenging ascent toward <strong>Sembalun Crater Rim (2,639 m)</strong>. The final section involves a long uphill climb with several switchbacks." },
      { time: "Upon reaching the crater rim", text: "Upon reaching the crater rim, the Asgard Rinjani Trekking porter team will prepare your campsite and camping facilities. Take time to relax and enjoy breathtaking views of <strong>Segara Anak Lake, the surrounding mountains, and the spectacular sunset</strong>." },
      { time: "In the evening", text: "In the evening, enjoy a freshly prepared dinner from your trekking team before settling into your tent for an overnight stay at Sembalun Crater Rim." },
    ],
    summary: [
      { label: "Trekking distance:", value: "Approximately 9 km" },
      { label: "Trekking time:", value: "Approximately 6–7 hours" },
      { label: "Highest point:", value: "2,639 m" },
      { label: "Meals:", value: "Breakfast, lunch & dinner" },
      { label: "Overnight:", value: "Sembalun Crater Rim" },
    ],
  },
  {
    day: "Day 2",
    title: "Day 2: Mount Rinjani Summit Sunrise – Descent to Sembalun Village",
    paragraphs: [
      'Your summit day begins very early. At approximately <strong>2:00 AM</strong>, your trekking team will wake you up for a light breakfast before preparing for the challenging ascent to <strong>Mount Rinjani Summit (3,726 m)</strong>.',
      "The trail becomes increasingly steep and rocky as you climb through volcanic terrain. The final section consists of loose volcanic sand and gravel, requiring careful steps and a steady pace. Your guide will accompany you throughout the ascent, with regular short breaks along the way.",
      'After approximately <strong>3–4 hours</strong>, you will reach the magnificent <strong>Mount Rinjani Summit (3,726 m)</strong>, the highest point of Lombok.',
      'Celebrate your achievement while enjoying breathtaking sunrise views across <strong>Lombok, Bali, Sumbawa, and Segara Anak Lake</strong>. On clear mornings, the surrounding islands and distant mountains create an unforgettable panoramic landscape.',
      "After spending time at the summit and capturing photographs, begin the descent toward the crater rim campsite. Although the descent is generally faster, the loose volcanic terrain can still be challenging, so follow your guide's instructions and take care along the trail.",
      "Upon returning to the campsite, enjoy a freshly prepared breakfast and take a short rest while the Asgard Rinjani Trekking porter team organizes the camping equipment.",
      'The journey then continues downhill along the Sembalun trail toward <strong>Sembalun Village</strong>. Along the way, enjoy the changing mountain scenery, with regular rest stops to refresh and recover. A freshly prepared lunch, fresh fruit, and snacks will be provided by the trekking team according to the package arrangements.',
      "After reaching Sembalun Village, your trekking adventure comes to an end. Our team will arrange your return transfer to Senaru, where you can continue your journey to your next destination.",
      "Thank you for choosing <strong>Asgard Rinjani Trekking</strong> for your Mount Rinjani summit adventure. We hope this incredible journey has given you unforgettable memories of Lombok's magnificent mountain landscape.",
    ],
    timeline: [
      { time: "2:00 AM", text: "Your summit day begins very early. At approximately 2:00 AM, your trekking team will wake you up for a light breakfast before preparing for the challenging ascent to <strong>Mount Rinjani Summit (3,726 m)</strong>." },
      { time: "3–4 hours", text: "After approximately 3–4 hours, you will reach the magnificent <strong>Mount Rinjani Summit (3,726 m)</strong>, the highest point of Lombok." },
      { time: "Sunrise", text: "Celebrate your achievement while enjoying breathtaking sunrise views across <strong>Lombok, Bali, Sumbawa, and Segara Anak Lake</strong>. On clear mornings, the surrounding islands and distant mountains create an unforgettable panoramic landscape." },
      { time: "After spending time at the summit", text: "After spending time at the summit and capturing photographs, begin the descent toward the crater rim campsite. Although the descent is generally faster, the loose volcanic terrain can still be challenging, so follow your guide's instructions and take care along the trail." },
      { time: "Upon returning to the campsite", text: "Upon returning to the campsite, enjoy a freshly prepared breakfast and take a short rest while the Asgard Rinjani Trekking porter team organizes the camping equipment." },
      { time: "Along the Sembalun trail", text: "The journey then continues downhill along the Sembalun trail toward <strong>Sembalun Village</strong>. Along the way, enjoy the changing mountain scenery, with regular rest stops to refresh and recover." },
      { time: "After reaching Sembalun Village", text: "After reaching Sembalun Village, your trekking adventure comes to an end. Our team will arrange your return transfer to Senaru, where you can continue your journey to your next destination." },
    ],
    summary: [
      { label: "Summit altitude:", value: "3,726 m" },
      { label: "Summit climb:", value: "Approximately 3–4 hours" },
      { label: "Descent:", value: "Approximately 5–6 hours" },
      { label: "Meals:", value: "Breakfast & lunch" },
      { label: "End point:", value: "Sembalun Village, followed by return transfer to Senaru" },
    ],
  },
];

const gallery = [
  { src: "/asgard-rinjani-trekking/images/summit08.jpg", alt: "Mount Rinjani summit route across high volcanic terrain" },
  { src: "/asgard-rinjani-trekking/images/summit10.jpg", alt: "High mountain landscape along the Mount Rinjani summit trek" },
  { src: "/asgard-rinjani-trekking/images/summit01.jpg", alt: "Scenic view of Mount Rinjani on the summit route" },
];

const details = [
  { label: "Duration", value: "2 Days · 1 Night" },
  { label: "Starting point", value: "Sembalun route (details to be confirmed)" },
  { label: "Finishing point", value: "To be confirmed for your route" },
  { label: "Difficulty", value: "To be confirmed with your guide" },
  { label: "Maximum elevation", value: "Confirm with the team for your dates" },
  { label: "Camping location", value: "Confirm with the team for your dates" },
];

const inclusionGroups = [
  {
    title: "Trekking Services",
    items: [
      "Professional trekking guide and porter support for shared camping equipment, food, and cooking supplies throughout the trek.",
      "Mount Rinjani National Park permits and entrance tickets, as confirmed for your departure.",
      "Round-trip trekking transfers: Transfer from the Senaru meeting point to Sembalun Village on Day 1, and return transfer from Sembalun Village to the Senaru meeting point on Day 2.",
    ],
  },
  {
    title: "Meals and Drinks",
    items: [
      "Meals shown in the itinerary: Day 1 lunch and dinner; Day 2 breakfast and lunch.",
      "Drinking water, fresh fruit, tea, and coffee during the trek, subject to the final written package confirmation.",
    ],
  },
  {
    title: "Camping Equipment",
    items: [
      "Mountain camping equipment for one overnight camp, including tents, sleeping bags, mattresses, and pillows.",
      "Shared cooking and dining equipment and a portable toilet tent at camp, subject to the final written package confirmation.",
    ],
  },
  {
    title: "Complimentary Trekking Equipment",
    items: [
      "Warm jackets, trekking poles, headlamps, and gloves may be available to borrow at no extra charge, subject to availability. Request items in advance and confirm availability with Asgard Rinjani Trekking.",
    ],
  },
];

const exclusionGroups = [
  {
    title: "Personal Expenses",
    items: [
      "Personal purchases and expenses not listed in the confirmed package inclusions or trek itinerary.",
    ],
  },
  {
    title: "Personal Trekking Equipment",
    items: [
      "Personal clothing, footwear, and trekking equipment. Complimentary equipment loans, if available, are limited to the items and availability confirmed by the team.",
    ],
  },
  {
    title: "Accommodation",
    items: [
      "Accommodation before and after the trekking program is not included in the package price. Guests are responsible for arranging their own hotel or guesthouse in Lombok. If you need accommodation recommendations, please contact our team in advance.",
    ],
  },
  {
    title: "Tips and Gratuities",
    items: [
      "Tips or gratuities for guides, porters, drivers, or other service providers are not included and are at the guest’s discretion.",
    ],
  },
  {
    title: "Other Exclusions",
    items: [
      "Flights to and from Lombok, travel insurance, personal luggage porter service, and any service or cost not expressly listed in the confirmed package inclusions.",
    ],
  },
];

const faqs = [
  { question: "How difficult is the Mount Rinjani Summit Trek?", answer: "The route may involve steep, uneven terrain, altitude, and long walking sections. Physical preparation is important; confirm current difficulty guidance with the trekking team." },
  { question: "Which route and starting point are used?", answer: "The existing package outline describes a Sembalun-to-summit route. Exact trailhead, route plan, and finish point are to be confirmed with Asgard Rinjani Trekking before booking." },
  { question: "Is a summit attempt guaranteed?", answer: "A summit attempt depends on the confirmed itinerary, weather, safety decisions, and applicable park rules. Summit access cannot be guaranteed." },
  { question: "Do I need previous trekking experience?", answer: "Previous trekking experience is helpful. Discuss your experience and fitness with the team and prepare physically for the confirmed route." },
  { question: "What personal equipment should I bring?", answer: "Bring suitable layered trekking clothing, comfortable hiking footwear, personal essentials, and all items listed in the confirmed packing list." },
  { question: "What is included in the package?", answer: "Package inclusions have not yet been confirmed. Request the current written inclusions and exclusions from Asgard Rinjani Trekking before booking." },
  { question: "How do I confirm a booking and the operating details?", answer: "Contact the team with your preferred dates and group size. Availability, booking requirements, itinerary, and operating details are to be confirmed directly before payment or travel arrangements." },
];
---

<Layout title="Mount Rinjani Summit Trek | 2 Days, 1 Night | Asgard" description="Attempt Mount Rinjani’s 3,726 m summit on a two-day, one-night trek from Sembalun. Review the itinerary and package details before planning your departure." ogImage="/asgard-rinjani-trekking/images/optimized/package-summit12.webp" ogImageAlt="Mount Rinjani summit ridge above the clouds on the summit trek">
  <PackageDetailFrame title={title} heading={"Mount Rinjani Summit"} route={"Sembalun route · summit attempt subject to conditions and final confirmation"} subtitle={"Two days. One night. A journey toward Mount Rinjani\u0027s summit."} note={"Route details and operating conditions are confirmed with our team before booking."} heroImage={"/asgard-rinjani-trekking/images/optimized/package-summit12.webp"} heroAlt={"Mount Rinjani summit ridge above the clouds"} bookingHref={bookingHref} details={details} gallery={gallery} galleryTitle={"The mountain, unfolding."} galleryDescription={"A glimpse of the Rinjani landscapes found across the route."}>

    <section class="section overview" id="overview" aria-labelledby="overview-title">
      <div class="container">
        <div class="section-intro">
          <p class="eyebrow">The journey</p>
          <h2 class="section-heading" id="overview-title">A journey toward <em>the summit.</em></h2>
          <p class="section-copy">Spend two days and one night on Mount Rinjani's summit route. Exact route, daily plan, and logistics are to be confirmed with our team for your dates.</p>
        </div>
        <dl class="trip-facts">
          {details.map((item) => <div class="fact"><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
        <div class="highlights">
          <div><p class="eyebrow">At a glance</p><h3>Made for the <em>mountain in view.</em></h3></div>
          <ul>{highlights.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section facilities" aria-labelledby="facilities-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Plan with clarity</p><h2 class="section-heading" id="facilities-title"><em>Inclusions.</em></h2><p class="section-copy">Review the services and equipment associated with the trek. Confirm the final written inclusions for your dates and selected booking option before departure.</p></div>
        <p class="inclusion-note">Transfers between the Senaru meeting point and Sembalun Village are part of the trekking package. Transportation between other Lombok locations and Senaru is included only when the Trek + Transportation booking option is selected and confirmed. Day 0 accommodation is arranged separately unless an additional service is confirmed in writing.</p>
        <div class="facility-grid">{inclusionGroups.map((group) => <article><span class="facility-mark" aria-hidden="true">✓</span><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
        <div class="section-intro inclusion-subheading"><p class="eyebrow">Plan with clarity</p><h2 class="section-heading"><em>Exclusions.</em></h2><p class="section-copy">The following items are not included unless they are specifically confirmed in writing with your booking.</p></div>
        <div class="facility-grid">{exclusionGroups.map((group) => <article><span class="facility-mark" aria-hidden="true">–</span><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
      </div>
    </section>

<section class="section itinerary" id="itinerary" aria-labelledby="itinerary-title">
      <div class="container">
        <div class="section-intro centered">
          <p class="eyebrow">Two days on the mountain</p>
          <h2 class="section-heading" id="itinerary-title">The outline of <em>a summit journey.</em></h2>
          <p class="section-copy">This is a planning outline. Exact timing, trail, camp, and activities depend on the confirmed operator itinerary and conditions.</p>
        </div>
        <ol class="day-list">
          {itinerary.map((item) => (
            <li class:list={["day-card", item.day === "Day 0" && "day-card-arrival"]}>
              <span class="day-index">{item.day === "Day 0" ? item.day : item.day.replace("Day ", "")}</span>
              <div class="day-card-content">
                <h3>{item.title}</h3>
                {item.day === "Day 0" ? (
                  <>
                    <p class="arrival-intro">{item.intro}</p>
                    <div class="arrival-panels">
                      <section class="arrival-panel" aria-labelledby="pickup-schedule-title">
                        <h4 id="pickup-schedule-title"><span class="arrival-icon" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M3 16.5h18M5 16.5V12l2-5h10l2 5v4.5M7 16.5v2m10-2v2M7 12h10M8.5 9h7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7.5" cy="16.5" r="1" fill="currentColor"/><circle cx="16.5" cy="16.5" r="1" fill="currentColor"/></svg></span>Pick-Up Schedule</h4>
                        <ul class="arrival-list">{item.pickupSchedule.map((entry) => <li><strong>{entry.location}</strong><span>{entry.time}</span></li>)}</ul>
                      </section>
                      <section class="arrival-panel" aria-labelledby="transfer-times-title">
                        <h4 id="transfer-times-title"><span class="arrival-icon" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Estimated Transfer Times</h4>
                        <ul class="arrival-list">{item.transferTimes.map((entry) => <li><strong>{entry.location}</strong><span>{entry.time}</span></li>)}</ul>
                      </section>
                    </div>
                    <aside class="arrival-recommendation"><span class="recommendation-label">Our Recommendation</span><p>{item.recommendation}</p></aside>
                    <section class="arrival-accommodation" aria-labelledby="overnight-accommodation-title">
                      <h4 id="overnight-accommodation-title"><span class="arrival-icon" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M3.5 19V8.5L12 4l8.5 4.5V19M2.5 19h19M7 19v-6h10v6M9 10h.01M15 10h.01" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Pre-Trek Accommodation &amp; Briefing</h4>
                      <p>{item.accommodation}</p>
                    </section>
                  </>
                ) : (
                  <>
                    {item.paragraphs.map((paragraph, index) => (
                      <>
                        <p class="day-description" set:html={paragraph}></p>
                        {index === 2 && item.stops && <ul class="route-stops">{item.stops.map((stop) => <li><strong>{stop.name}</strong><span>– {stop.detail}</span></li>)}</ul>}
                      </>
                    ))}
                    <h4 class="itinerary-heading">Approximate Timeline</h4>
                    <div class="itinerary-timeline">
                      {item.timeline.map((entry) => <p class="itinerary-entry"><strong>{entry.time}</strong><span set:html={`– ${entry.text}`}></span></p>)}
                    </div>
                    <div class="itinerary-summary">{item.summary.map((fact) => <p><strong>{fact.label}</strong>{fact.value}</p>)}</div>
                  </>
                )}
              </div>
              <span class="day-mark" aria-hidden="true">→</span>
            </li>
          ))}
        </ol>
        <aside class="itinerary-timing-note">
          <h3>Important Note</h3>
          <p>The <strong>2 Days 1 Night Summit Trekking Program</strong> is a very challenging mountain trek and is best suited to travelers with appropriate physical preparation and trekking experience.</p>
          <p>This program focuses on reaching the highest point of Mount Rinjani at <strong>3,726 m</strong>. It does not include a visit to <strong>Segara Anak Lake or the natural hot springs</strong>, as the itinerary is specifically designed for the summit experience.</p>
          <p>The trekking schedule is approximate and may be adjusted by your guide depending on weather conditions, trail conditions, and the group's pace.</p>
        </aside>
      </div>
    </section>

    

    

        <section class="section trekking-info" id="trekking-info" aria-labelledby="trekking-info-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Plan with confidence</p><h2 class="section-heading" id="trekking-info-title">Important Information <em>Before Your Trek.</em></h2><p class="section-copy">Routes, schedules, and operating plans can change with mountain conditions and park guidance. Confirm the final meeting point, route, camping plan, packing list, and package arrangements with our team before departure.</p></div>
        <div class="info-grid">
          <article><span class="info-label">What to Bring</span><p>Bring suitable trekking clothing, comfortable hiking footwear, personal essentials, and all items listed in the confirmed packing list. Ask the team for the route-specific list before departure.</p></article>
          <article><span class="info-label">Free Trekking Equipment</span><p>At Asgard Rinjani Trekking, we want every guest to feel comfortable and well-prepared throughout their Mount Rinjani adventure.</p><p>To help make your trekking experience more convenient, we provide complimentary equipment loans for the following items, subject to availability:</p><ul class="equipment-loan-list"><li>Warm trekking jackets.</li><li>Trekking poles.</li><li>Headlamps.</li><li>Gloves.</li><li>All other equipment listed in the Inclusions section.</li></ul><p>Guests who require any of these items are encouraged to inform our team in advance so we can check availability and prepare the equipment before departure.</p><p>Please note that these items are provided as complimentary loans and must be returned to our team after the trekking program.</p><p>We recommend bringing your own personal trekking shoes, comfortable hiking clothes, and other essential personal equipment.</p></article>
          <article><span class="info-label">Additional Information</span><p>This two-day, one-night journey is planned on the Sembalun route, with a summit attempt subject to confirmation. Mount Rinjani’s summit is 3,726 m; the itinerary, campsite, and exact walking schedule should be confirmed with the team for your dates.</p><p>The high mountain ascent involves steep, uneven terrain and long walking sections. Good physical preparation and previous hiking experience are helpful. A summit visit depends on weather, trail conditions, safety decisions, and park guidance and cannot be guaranteed.</p><p>Check current Mount Rinjani National Park regulations and the latest route guidance before departure. Bring the personal clothing and essentials listed in the confirmed packing information.</p></article>
          <article><span class="info-label">Why Choose Asgard Rinjani Trekking?</span><p>Plan your Mount Rinjani journey with a local Lombok trekking team. Contact us for route-specific preparation guidance and to confirm the arrangements for your dates.</p></article>
        </div>
      </div>
    </section><section class="section faq" aria-labelledby="faq-title">
      <div class="container faq-container">
        <header class="faq-heading">
          <p class="eyebrow">Frequently Asked Questions</p>
          <h2 class="section-heading" id="faq-title">Everything You Need to <em>Know.</em></h2>
          <p class="section-copy">A few helpful details as you prepare for the Mount Rinjani Summit Trek.</p>
        </header>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <article class="faq-item">
              <h3>
                <button class="faq-trigger" type="button" id={`faq-trigger-${index}`} aria-expanded="false" aria-controls={`faq-panel-${index}`}>
                  <span>{faq.question}</span><span class="faq-icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="faq-panel" id={`faq-panel-${index}`} role="region" aria-labelledby={`faq-trigger-${index}`} aria-hidden="true" inert>
                <div class="faq-panel-inner"><p>{faq.answer}</p></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="route-showcase" aria-labelledby="route-showcase-title">
      <div class="container route-showcase-container">
        <header class="route-showcase-heading">
          <p class="eyebrow">EXPLORE MOUNT RINJANI</p>
          <h2 class="section-heading" id="route-showcase-title">Explore Your Rinjani Route</h2>
          <p class="section-copy">Follow the trail toward Rinjani’s summit, crossing the mountain’s open slopes and highland terrain on this two-day trek.</p>
        </header>
        <figure class="route-showcase-map">
          <img src="/asgard-rinjani-trekking/images/rinjani%20map/Rinjani%20Summit%20Trekking%20Route%20Map.png" alt="Rinjani Summit Trekking route map" loading="lazy" decoding="async" />
        </figure>
        <p class="route-showcase-caption">RINJANI SUMMIT TREK ROUTE</p>
      </div>
    </section>
  </PackageDetailFrame>
</Layout>

<style>
