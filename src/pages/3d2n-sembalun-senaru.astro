---
import Layout from "../layouts/Layout.astro";
import PackageDetailFrame from "../components/PackageDetailFrame.astro";
import { site, whatsappLink } from "../data/site";

const title = "Mount Rinjani Sembalun to Senaru Trekking - 3 Days 2 Nights";
const bookingHref = whatsappLink(
  "Hello Asgard Rinjani Trekking, I would like to enquire about the Mount Rinjani Sembalun to Senaru Trekking - 3 Days 2 Nights. Please share current availability, the confirmed itinerary, difficulty guidance, and package details.",
);

const highlights = [
  "A three-day, two-night traverse from Sembalun toward Senaru",
  "A changing mountain landscape along the confirmed route",
  "Summit or crater-rim sections only where included in the confirmed itinerary",
];

const itinerary = [
  {
    day: "Day 0",
    title: "Arrival in Senaru & Pre-Trek Preparation",
    intro: "Day 0 is reserved for arriving in Senaru and preparing for the Senaru Crater Rim trek. The pick-up schedule and estimated transfer times below can help you plan your journey; please confirm with Asgard Rinjani Trekking whether transport from your location is included in your booking and coordinate the arrangements with the team. Pre-trek accommodation in Senaru is not included in the package price, so please arrange your own stay unless separate arrangements have been confirmed.",
    pickupSchedule: [
      { location: "Kuta Lombok", time: "09:00 AM or 04:00–05:00 PM" },
      { location: "Senggigi / Mataram", time: "10:00–11:00 AM or 04:00 PM" },
      { location: "Tetebatu / Pringgasela", time: "09:00–10:00 AM" },
      { location: "Bangsal Harbor / Gili Islands", time: "Around 11:30 AM (following your boat arrival)" },
    ],
    recommendation: "If a morning transfer is available and included in your confirmed booking, we recommend choosing it where possible. This allows time to relax, explore Senaru Village and rest before the trek.",
    transferTimes: [
      { location: "Lombok International Airport (LOP) / Lembar Harbor", time: "Approximately 3.5 hours" },
      { location: "Mataram / Senggigi", time: "Approximately 2 hours" },
      { location: "Bangsal Harbor", time: "Approximately 1 hour 25 minutes" },
      { location: "Kuta Lombok / Tetebatu", time: "Approximately 4 hours" },
      { location: "Labuan Lombok (Kayangan Harbor)", time: "Approximately 2 hours" },
    ],
    accommodation: "Pre-trek accommodation in Senaru is not included in the trekking package price. Guests are responsible for arranging their own stay unless separate arrangements have been made. If included in your confirmed package, the evening preparation may include a trekking guide briefing, equipment inspection and overview of the adventure; coordinate the details with the team.",
    details: [
    ],
    summary: [],
  },
  {
    day: "Day 1",
    title: "Day 1: Sembalun Village to Sembalun Crater Rim",
    paragraphs: [
      "Your Mount Rinjani adventure with <strong>Asgard Rinjani Trekking</strong> begins after breakfast in Senaru. Our team will arrange your morning transfer to <strong>Sembalun Village (1,100 m)</strong>, the starting point of your trekking journey. The drive takes approximately <strong>45–60 minutes</strong>.",
      "Upon arrival, you will complete the registration process at the Mount Rinjani National Park entrance. After a short trekking briefing with your guide, the adventure begins across the beautiful open savanna of Sembalun, surrounded by wide grasslands and spectacular mountain scenery.",
      "The trail gradually climbs through rolling grasslands, passing several trekking posts along the way. You will pass <strong>Pos 1 (1,300 m)</strong> and <strong>Pos 2 (1,500 m)</strong> before continuing towards <strong>Pos 3 (1,800 m)</strong>, where you will enjoy a freshly prepared lunch from the Asgard Rinjani Trekking team and take a well-deserved break.",
      "In the afternoon, the trail becomes increasingly steep as you make your way towards <strong>Sembalun Crater Rim (2,639 m)</strong>. Your guide will help maintain a comfortable trekking pace, with regular rest stops along the challenging uphill sections.",
      "After reaching the campsite, your porter team will prepare the camping facilities. Take time to relax and enjoy spectacular panoramic views of <strong>Segara Anak Lake, Mount Rinjani's volcanic landscape, and the surrounding mountains of Lombok</strong>.",
      "In the evening, enjoy a freshly prepared dinner served by your trekking team. Relax beneath the clear mountain sky and get some rest before the early-morning ascent to <strong>Mount Rinjani Summit (3,726 m)</strong>.",
    ],
    timeline: [
      { time: "07:00 AM", text: "Transfer from Senaru to Sembalun Village." },
      { time: "07:45 AM", text: "Registration at the Mount Rinjani National Park entrance." },
      { time: "08:30 AM", text: "Begin trekking from Sembalun Village through the beautiful open savanna." },
      { time: "12:00 PM", text: "Break at Pos 2 for rest and refreshments." },
      { time: "01:00 PM", text: "Enjoy a freshly prepared lunch at Pos 3." },
      { time: "02:00 PM", text: "Continue trekking towards Sembalun Crater Rim." },
      { time: "05:30 PM", text: "Arrive at the campsite and enjoy the spectacular mountain scenery." },
      { time: "06:30 PM", text: "Dinner prepared by the Asgard Rinjani Trekking team, followed by an overnight stay at Sembalun Crater Rim." },
    ],
  },
  {
    day: "Day 2",
    title: "Day 2: Mount Rinjani Summit, Segara Anak Lake & Senaru Crater Rim",
    paragraphs: [
      "Day 2 is the most challenging and rewarding day of your <strong>Mount Rinjani trekking adventure</strong>. The day begins in the early hours with a pre-dawn ascent from Sembalun Crater Rim towards the magnificent <strong>Mount Rinjani Summit (3,726 m)</strong>.",
      "After a wake-up call from your trekking team, enjoy a light breakfast before preparing for the summit climb. Your guide will accompany you throughout the ascent, helping you maintain a steady pace along the challenging volcanic trail.",
      "Reaching the summit at sunrise offers breathtaking panoramic views across <strong>Lombok, Bali, Sumbawa, and the spectacular Segara Anak Lake</strong> below. Take time to appreciate the incredible scenery and celebrate reaching the highest point of your adventure.",
      "After enjoying the summit, begin descending back to Sembalun Crater Rim campsite. Upon arrival, enjoy a freshly prepared breakfast and take some time to rest before continuing the journey.",
      "The trail then descends towards <strong>Segara Anak Lake</strong>, passing through the dramatic volcanic landscape of Mount Rinjani. Upon reaching the lake, enjoy a freshly prepared lunch from the Asgard Rinjani Trekking team and take time to relax beside the beautiful crater lake.",
      "A visit to the <strong>natural hot springs near Segara Anak Lake</strong> provides a welcome opportunity to relax and recover after the demanding summit climb.",
      "In the afternoon, prepare for the next challenging section as you continue climbing towards <strong>Senaru Crater Rim (2,641 m)</strong>. The route offers spectacular views of the crater, Segara Anak Lake, and the surrounding volcanic landscape.",
      "After reaching Senaru Crater Rim, your porter team will prepare the campsite and arrange your camping facilities. Enjoy the spectacular sunset over the crater and surrounding mountains before having a freshly prepared dinner.",
      "Spend another memorable night camping on Mount Rinjani, surrounded by the extraordinary mountain landscape.",
    ],
    timeline: [
      { time: "02:00 AM", text: "Wake-up call with a light breakfast." },
      { time: "02:30 AM", text: "Begin the Mount Rinjani summit ascent." },
      { time: "05:30–06:00 AM", text: "Reach the summit (3,726 m) for sunrise and panoramic views." },
      { time: "06:30 AM", text: "Begin descending to Sembalun Crater Rim campsite." },
      { time: "08:00 AM", text: "Enjoy breakfast and take a short rest at camp." },
      { time: "09:30 AM", text: "Begin the descent towards Segara Anak Lake." },
      { time: "12:30 PM", text: "Arrive at Segara Anak Lake, enjoy lunch, and relax beside the lake." },
      { time: "01:30 PM", text: "Visit the natural hot springs near Segara Anak Lake." },
      { time: "02:30 PM", text: "Continue trekking towards Senaru Crater Rim." },
      { time: "05:30 PM", text: "Arrive at Senaru Crater Rim campsite and enjoy the spectacular sunset views." },
      { time: "Evening", text: "Freshly prepared dinner and overnight camping at <strong>Senaru Crater Rim (2,641 m)</strong>." },
    ],
  },
  {
    day: "Day 3",
    title: "Day 3: Senaru Crater Rim to Senaru Village",
    paragraphs: [
      "Wake up to spectacular morning views from <strong>Senaru Crater Rim (2,641 m)</strong> before enjoying a freshly prepared breakfast from the Asgard Rinjani Trekking team.",
      "After breakfast, prepare for the final day of your Mount Rinjani trekking adventure. Your guide and porter team will help organize the camping equipment before beginning the descent towards Senaru Village.",
      "The trail descends through the lush tropical rainforest of <strong>Mount Rinjani National Park</strong>, where the cooler surroundings provide a refreshing change after the previous day's challenging summit and crater trek.",
      "Along the way, enjoy the peaceful forest atmosphere, towering tropical trees, and beautiful natural surroundings. With some luck, you may also spot local wildlife, including monkeys and a variety of tropical birds.",
      "Your guide will arrange regular rest stops along the trail to allow you to relax, hydrate, and enjoy the surrounding rainforest scenery.",
      "After several hours of descending, continue towards <strong>Senaru Village (approximately 600 m)</strong>. Upon reaching the village, your three-day, two-night Mount Rinjani trekking adventure comes to an end.",
      "Thank you for choosing <strong>Asgard Rinjani Trekking</strong> to be part of your Mount Rinjani journey. We hope this incredible adventure has created unforgettable memories of Lombok's mountains, volcanic landscapes, and natural beauty.",
    ],
    timeline: [
      { time: "07:30 AM", text: "Enjoy breakfast at Senaru Crater Rim campsite." },
      { time: "08:30 AM", text: "Begin the descent towards Senaru Village." },
      { time: "Midday", text: "Take regular rest stops along the tropical rainforest trail to relax and enjoy refreshments." },
      { time: "01:30–03:30 PM", text: "Arrive at Senaru Village, marking the end of your trekking adventure." },
    ],
  },
];

const gallery = [
  { src: "/asgard-rinjani-trekking/images/smbln09.jpg", alt: "Mount Rinjani landscape along the Sembalun to Senaru traverse" },
  { src: "/asgard-rinjani-trekking/images/smbln22.jpg", alt: "Mountain scenery on the Sembalun to Senaru route" },
  { src: "/asgard-rinjani-trekking/images/smbln21.jpg", alt: "Trail landscape across Mount Rinjani on the way to Senaru" },
];

const details = [
  { label: "Duration", value: "3 Days · 2 Nights" },
  { label: "Starting point", value: "Sembalun (confirm meeting point)" },
  { label: "Finishing point", value: "Senaru (confirm trailhead and transfer)" },
  { label: "Difficulty", value: "To be confirmed with your guide" },
  { label: "Maximum elevation", value: "Confirm with the team for your dates" },
  { label: "Camping location", value: "Confirm with the team for your dates" },
];

const inclusionGroups = [
  {
    title: "Trekking Services",
    items: [
      "Trekking guide and porter support for shared camping equipment, food, and cooking supplies.",
      "Mount Rinjani National Park permits and entrance tickets, as confirmed for your departure.",
      "Round-trip trekking transfers: Transfer from the Senaru trekking office to Sembalun Village on Day 1, and return transfer from Senaru Village to the Senaru trekking office on Day 3.",
    ],
  },
  {
    title: "Meals and Drinks",
    items: [
      "Meals shown in the itinerary: Day 1 lunch and dinner; Day 2 breakfast, lunch, and dinner; Day 3 breakfast and lunch.",
      "Drinking water, fresh fruit, tea, and coffee during the trek, subject to the final written package confirmation.",
    ],
  },
  {
    title: "Camping Equipment",
    items: [
      "Mountain camping equipment for the two overnight camps, including tents, sleeping bags, mattresses, and pillows.",
      "Shared cooking and dining equipment and a portable toilet tent at camp, subject to the final written package confirmation.",
    ],
  },
  {
    title: "Complimentary Trekking Equipment",
    items: [
      "Warm jackets, trekking poles, headlamps, and gloves may be available to borrow at no extra charge, subject to availability. Request items in advance and confirm availability with Asgard Rinjani Trekking.",
    ],
  },
];

const exclusionGroups = [
  {
    title: "Personal Expenses",
    items: [
      "Personal purchases and expenses not listed in the confirmed package inclusions or trek itinerary.",
    ],
  },
  {
    title: "Personal Trekking Equipment",
    items: [
      "Personal clothing, footwear, and trekking equipment. Complimentary equipment loans, if available, are limited to the items and availability confirmed by the team.",
    ],
  },
  {
    title: "Accommodation",
    items: [
      "Accommodation before and after the trekking program is not included in the package price. Guests are responsible for arranging their own hotel or guesthouse in Lombok. If you need accommodation recommendations, please contact our team in advance.",
    ],
  },
  {
    title: "Tips and Gratuities",
    items: [
      "Tips or gratuities for guides, porters, drivers, or other service providers are not included and are at the guest’s discretion.",
    ],
  },
  {
    title: "Other Exclusions",
    items: [
      "Flights, travel insurance, personal luggage porter service, and any service or cost not expressly listed in the confirmed package inclusions.",
      "Flights and airfare to and from Lombok are not included in the trekking package.",
    ],
  },
];

const faqs = [
  { question: "What is the Sembalun to Senaru route?", answer: "It is a three-day, two-night trekking package planned from Sembalun toward Senaru. Exact trail sections and overnight stops are to be confirmed with the operator." },
  { question: "How demanding is this three-day trek?", answer: "Expect extended walking over varied mountain terrain. Good physical preparation is important; ask the guide for current route-specific difficulty advice." },
  { question: "Does the itinerary include the summit or crater rim?", answer: "Summit or crater-rim sections depend on the package itinerary confirmed for your dates. Please verify the planned route and activities before booking." },
  { question: "Where does the trek start and finish?", answer: "The planned direction is Sembalun to Senaru. Exact meeting point, trailhead, finish point, and transfers are to be confirmed with the team." },
  { question: "What personal equipment should I bring?", answer: "Bring suitable layered trekking clothing, comfortable hiking footwear, personal essentials, and the items listed in the confirmed packing list." },
  { question: "What is included in the package?", answer: "Package inclusions and exclusions have not yet been confirmed. Request the current written list from Asgard Rinjani Trekking before booking." },
  { question: "Can weather or conditions change the route?", answer: "The itinerary may be adjusted based on weather, mountain safety, or applicable national park regulations. Confirm current operating guidance with the team." },
  { question: "Can I book privately or confirm availability?", answer: "Contact Asgard Rinjani Trekking with your dates and group size. Private arrangements and availability are subject to operational confirmation." },
];
---

<Layout title="Sembalun to Senaru Trek | 3 Days, 2 Nights | Asgard" description="Travel from Sembalun toward Senaru on a three-day, two-night Mount Rinjani trek. Review the route outline, included services and departure details before booking." ogImage="/asgard-rinjani-trekking/images/optimized/package-smbln05.webp" ogImageAlt="Mount Rinjani volcanic landscape on the Sembalun to Senaru route">
  <PackageDetailFrame title={title} heading={"Sembalun to Senaru"} route={"Sembalun to Senaru · stages and stops to be confirmed"} subtitle={"Three days. Two nights. A journey across Rinjani’s changing mountain world."} note={"Route details and operating conditions are confirmed with our team before booking."} heroImage={"/asgard-rinjani-trekking/images/optimized/package-smbln05.webp"} heroAlt={"Mount Rinjani volcanic landscape on the Sembalun to Senaru route"} bookingHref={bookingHref} details={details} gallery={gallery} galleryTitle={"The mountain, unfolding."} galleryDescription={"A glimpse of the Rinjani landscapes found across the route."}>

    <section class="section overview" id="overview" aria-labelledby="overview-title">
      <div class="container">
        <div class="section-intro">
          <p class="eyebrow">The journey</p>
          <h2 class="section-heading" id="overview-title">A traverse through <em>Rinjani.</em></h2>
          <p class="section-copy">Follow a three-day, two-night route across the mountain, from Sembalun toward Senaru. Our team will confirm the final route, daily plan, and logistics for your dates.</p>
        </div>
        <dl class="trip-facts">
          {details.map((item) => <div class="fact"><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
        <div class="highlights">
          <div><p class="eyebrow">At a glance</p><h3>Made for the <em>long way through.</em></h3></div>
          <ul>{highlights.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section facilities" aria-labelledby="facilities-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Plan with clarity</p><h2 class="section-heading" id="facilities-title"><em>Inclusions.</em></h2><p class="section-copy">Review the services and equipment associated with the trek. Confirm the final written inclusions for your dates and selected booking option before departure.</p></div>
        <p class="inclusion-note">Both Trek Only and Trek &amp; Transportation include round-trip transfers between the Senaru trekking office and the Sembalun starting point and Senaru trekking exit. Trek Only does not include pickup from another Lombok location to the office or onward drop-off from the office. Trek &amp; Transportation additionally includes the agreed pickup and drop-off between the office and your chosen location in Lombok. Day 0 accommodation is arranged separately unless an additional service is confirmed in writing.</p>
        <div class="facility-grid">{inclusionGroups.map((group) => <article><span class="facility-mark" aria-hidden="true">✓</span><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
        <div class="section-intro inclusion-subheading"><p class="eyebrow">Plan with clarity</p><h2 class="section-heading"><em>Exclusions.</em></h2><p class="section-copy">The following items are not included unless they are specifically confirmed in writing with your booking.</p></div>
        <div class="facility-grid">{exclusionGroups.map((group) => <article><span class="facility-mark" aria-hidden="true">–</span><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
      </div>
    </section>

<section class="section itinerary" id="itinerary" aria-labelledby="itinerary-title">
      <div class="container">
        <div class="section-intro centered">
          <p class="eyebrow">Three days on the mountain</p>
          <h2 class="section-heading" id="itinerary-title">The outline of <em>an expedition.</em></h2>
          <p class="section-copy">This is a planning outline. Exact timing, stops, camps, and activities depend on the confirmed operator itinerary and conditions.</p>
        </div>
        <ol class="day-list">
          {itinerary.map((item) => (
            <li class:list={["day-card", item.day === "Day 0" && "day-card-arrival"]}>
              <span class="day-index">{item.day === "Day 0" ? item.day : item.day.replace("Day ", "")}</span>
              <div class="day-card-content">
                <h3>{item.title}</h3>
                {item.day === "Day 0" ? (
                  <>
                    <p class="arrival-intro">{item.intro}</p>
                    <div class="arrival-panels">
                      <section class="arrival-panel" aria-labelledby="pickup-schedule-title">
                        <h4 id="pickup-schedule-title"><span class="arrival-icon" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M3 16.5h18M5 16.5V12l2-5h10l2 5v4.5M7 16.5v2m10-2v2M7 12h10M8.5 9h7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7.5" cy="16.5" r="1" fill="currentColor"/><circle cx="16.5" cy="16.5" r="1" fill="currentColor"/></svg></span>Pick-Up Schedule</h4>
                        <ul class="arrival-list">{item.pickupSchedule.map((entry) => <li><strong>{entry.location}</strong><span>{entry.time}</span></li>)}</ul>
                      </section>
                      <section class="arrival-panel" aria-labelledby="transfer-times-title">
                        <h4 id="transfer-times-title"><span class="arrival-icon" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Estimated Transfer Times</h4>
                        <ul class="arrival-list">{item.transferTimes.map((entry) => <li><strong>{entry.location}</strong><span>{entry.time}</span></li>)}</ul>
                      </section>
                    </div>
                    <aside class="arrival-recommendation"><span class="recommendation-label">Our Recommendation</span><p>{item.recommendation}</p></aside>
                    <section class="arrival-accommodation" aria-labelledby="overnight-accommodation-title">
                      <h4 id="overnight-accommodation-title"><span class="arrival-icon" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M3.5 19V8.5L12 4l8.5 4.5V19M2.5 19h19M7 19v-6h10v6M9 10h.01M15 10h.01" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Pre-Trek Accommodation &amp; Briefing</h4>
                      <p>{item.accommodation}</p>
                    </section>
                  </>
                ) : (
                  <>
                    {item.paragraphs.map((paragraph) => <p class="day-description" set:html={paragraph}></p>)}
                    <h4 class="itinerary-heading">Estimated Timeline</h4>
                    <div class="itinerary-timeline">
                      {item.timeline.map((entry) => <p class="itinerary-entry"><strong>{entry.time}</strong><span set:html={`– ${entry.text}`}></span></p>)}
                    </div>
                  </>
                )}
              </div>
              <span class="day-mark" aria-hidden="true">→</span>
            </li>
          ))}
        </ol>
        <aside class="itinerary-timing-note">
          <h3>Important Notes</h3>
          <ul class="important-notes">
            <li>Trekking schedules are approximate and may vary depending on weather conditions, trail conditions, and the group's trekking pace.</li>
            <li>Trekking poles are recommended to help reduce strain on the knees during the long descent. Complimentary trekking poles may be available from Asgard Rinjani Trekking, subject to availability.</li>
            <li>Please allow some flexibility in your onward travel plans, as arrival times in Senaru may vary depending on trekking conditions.</li>
            <li>Your guide will adjust the trekking schedule when necessary to ensure the group can complete the journey according to prevailing mountain conditions.</li>
          </ul>
        </aside>
      </div>
    </section>

    

    

        <section class="section trekking-info" id="trekking-info" aria-labelledby="trekking-info-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Plan with confidence</p><h2 class="section-heading" id="trekking-info-title">Important Information <em>Before Your Trek.</em></h2><p class="section-copy">Routes, schedules, and operating plans can change with mountain conditions and park guidance. Confirm the final meeting point, route, camping plan, packing list, and package arrangements with our team before departure.</p></div>
        <div class="info-grid">
          <article><span class="info-label">What to Bring</span><p>Bring suitable trekking clothing, comfortable hiking footwear, personal essentials, and all items listed in the confirmed packing list. Ask the team for the route-specific list before departure.</p></article>
          <article><span class="info-label">Free Trekking Equipment</span><p>At Asgard Rinjani Trekking, we want every guest to feel comfortable and well-prepared throughout their Mount Rinjani adventure.</p><p>To help make your trekking experience more convenient, we provide complimentary equipment loans for the following items, subject to availability:</p><ul class="equipment-loan-list"><li>Warm trekking jackets.</li><li>Trekking poles.</li><li>Headlamps.</li><li>Gloves.</li><li>All other equipment listed in the Inclusions section.</li></ul><p>Guests who require any of these items are encouraged to inform our team in advance so we can check availability and prepare the equipment before departure.</p><p>Please note that these items are provided as complimentary loans and must be returned to our team after the trekking program.</p><p>We recommend bringing your own personal trekking shoes, comfortable hiking clothes, and other essential personal equipment.</p></article>
          <article><span class="info-label">Additional Information</span><p>This three-day, two-night traverse is planned from Sembalun toward Senaru. The exact trail sections, overnight camps, and finish arrangements are confirmed for each departure, so review the full itinerary with the team before booking.</p><p>Expect extended walking over varied mountain terrain. Summit or crater-rim sections are included only when stated in your confirmed itinerary; do not assume either is part of the route. Prepare your fitness and personal gear for the stages confirmed for your dates.</p><p>Weather, trail conditions, safety guidance, and Mount Rinjani National Park regulations can affect access and daily plans. Confirm the meeting point, route, camping plan, and transfer arrangements before travel.</p></article>
          <article><span class="info-label">Why Choose Asgard Rinjani Trekking?</span><p>Plan your Mount Rinjani journey with a local Lombok trekking team. Contact us for route-specific preparation guidance and to confirm the arrangements for your dates.</p></article>
        </div>
      </div>
    </section><section class="section faq" aria-labelledby="faq-title">
      <div class="container faq-container">
        <header class="faq-heading">
          <p class="eyebrow">Frequently Asked Questions</p>
          <h2 class="section-heading" id="faq-title">Everything You Need to <em>Know.</em></h2>
          <p class="section-copy">A few helpful details as you prepare for the Sembalun to Senaru Trek.</p>
        </header>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <article class="faq-item">
              <h3>
                <button class="faq-trigger" type="button" id={`faq-trigger-${index}`} aria-expanded="false" aria-controls={`faq-panel-${index}`}>
                  <span>{faq.question}</span><span class="faq-icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="faq-panel" id={`faq-panel-${index}`} role="region" aria-labelledby={`faq-trigger-${index}`} aria-hidden="true" inert>
                <div class="faq-panel-inner"><p>{faq.answer}</p></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="route-showcase" aria-labelledby="route-showcase-title">
      <div class="container route-showcase-container">
        <header class="route-showcase-heading">
          <p class="eyebrow">EXPLORE MOUNT RINJANI</p>
          <h2 class="section-heading" id="route-showcase-title">Explore Your Rinjani Route</h2>
          <p class="section-copy">Trace a three-day journey from Sembalun toward Senaru through Rinjani’s changing mountain landscapes; confirm the final route and stages with your guide.</p>
        </header>
        <figure class="route-showcase-map">
          <img src="/asgard-rinjani-trekking/images/rinjani%20map/Mount%20Rinjani%203-Day%20Trekking%20Route%20Map%20(1).png" alt="Mount Rinjani three-day Sembalun to Senaru trekking route map" loading="lazy" decoding="async" />
        </figure>
        <p class="route-showcase-caption">SEMBALUN – SENARU · 3 DAYS, 2 NIGHTS</p>
      </div>
    </section>
  </PackageDetailFrame>
</Layout>

<style>
