---
import Layout from "../layouts/Layout.astro";
import PackageDetailFrame from "../components/PackageDetailFrame.astro";
import { site, whatsappLink } from "../data/site";

const title = "Grand Rinjani Trekking - 4 Days 3 Nights";
const bookingHref = whatsappLink(
  "Hello Asgard Rinjani Trekking, I would like to enquire about the Grand Rinjani Trekking - 4 Days 3 Nights. Please share current availability, the confirmed itinerary, difficulty guidance, and package details.",
);

const highlights = [
  "Four days and three nights for an extended Mount Rinjani journey",
  "More time to experience the mountain along the route confirmed for your dates",
  "Summit, crater-rim, or Segara Anak visits only where included in the confirmed itinerary",
];

const itinerary = [
  {
    day: "Day 0",
    title: "Arrival in Senaru & Pre-Trek Preparation",
    intro: "Day 0 is reserved for arriving in Senaru and preparing for the Senaru Crater Rim trek. The pick-up schedule and estimated transfer times below can help you plan your journey; please confirm with Asgard Rinjani Trekking whether transport from your location is included in your booking and coordinate the arrangements with the team. Pre-trek accommodation in Senaru is not included in the package price, so please arrange your own stay unless separate arrangements have been confirmed.",
    pickupSchedule: [
      { location: "Kuta Lombok", time: "09:00 AM or 04:00–05:00 PM" },
      { location: "Senggigi / Mataram", time: "10:00–11:00 AM or 04:00 PM" },
      { location: "Tetebatu / Pringgasela", time: "09:00–10:00 AM" },
      { location: "Bangsal Harbor / Gili Islands", time: "Around 11:30 AM (following your boat arrival)" },
    ],
    recommendation: "If a morning transfer is available and included in your confirmed booking, we recommend choosing it where possible. This allows time to relax, explore Senaru Village and rest before the trek.",
    transferTimes: [
      { location: "Lombok International Airport (LOP) / Lembar Harbor", time: "Approximately 3.5 hours" },
      { location: "Mataram / Senggigi", time: "Approximately 2 hours" },
      { location: "Bangsal Harbor", time: "Approximately 1 hour 25 minutes" },
      { location: "Kuta Lombok / Tetebatu", time: "Approximately 4 hours" },
      { location: "Labuan Lombok (Kayangan Harbor)", time: "Approximately 2 hours" },
    ],
    accommodation: "Pre-trek accommodation in Senaru is not included in the trekking package price. Guests are responsible for arranging their own stay unless separate arrangements have been made. If included in your confirmed package, the evening preparation may include a trekking guide briefing, equipment inspection and overview of the adventure; coordinate the details with the team.",
    details: [
    ],
    summary: [],
  },
  {
    day: "Day 1",
    title: "Day 1: Sembalun Village to Sembalun Crater Rim",
    paragraphs: [
      "Your <strong>Grand Rinjani Trekking adventure</strong> with Asgard Rinjani Trekking begins after breakfast in Senaru. Our team will arrange your morning transfer to <strong>Sembalun Village (1,100 m)</strong>, the starting point of your Mount Rinjani journey.",
      "Upon arrival, you will complete the registration process at the <strong>Rinjani Information Center</strong>. After a short briefing with your trekking guide, the adventure begins through the beautiful open savanna of Sembalun, surrounded by wide grasslands and spectacular mountain scenery.",
      "The trekking route passes through several mountain checkpoints, including Pos 1, Pos 2, and Pos 3, where you can take regular breaks to rest, enjoy refreshments, and appreciate the surrounding landscape. Around midday, you will stop at Pos 3 for a freshly prepared lunch from the Asgard Rinjani Trekking team.",
      "In the afternoon, continue your ascent towards <strong>Sembalun Crater Rim (2,639 m)</strong>. As the trail becomes steeper, your guide will help maintain a comfortable pace with regular rest stops along the challenging uphill sections.",
      "Upon reaching the crater rim, your porter team will prepare your campsite and arrange the camping facilities. From this spectacular viewpoint, enjoy breathtaking panoramic views of <strong>Mount Rinjani, Segara Anak Lake, and the surrounding mountains of Lombok</strong>.",
      "In the evening, enjoy a freshly prepared dinner while watching the beautiful sunset above the clouds. Relax beneath the clear mountain sky, enjoy the peaceful atmosphere, and get some rest before the early-morning ascent to the <strong>Mount Rinjani Summit (3,726 m)</strong>.",
    ],
    timeline: [
      { time: "07:00 AM", text: "Transfer from Senaru to Sembalun Village." },
      { time: "07:45 AM", text: "Registration and required park procedures at the Rinjani Information Center." },
      { time: "08:30 AM", text: "Begin trekking from Sembalun Gate through the beautiful Sembalun savanna." },
      { time: "12:15 PM", text: "Short break and refreshments at Pos 2." },
      { time: "01:15 PM", text: "Enjoy a freshly prepared lunch at Pos 3." },
      { time: "02:15 PM", text: "Continue the ascent towards Sembalun Crater Rim." },
      { time: "05:30 PM", text: "Arrive at <strong>Sembalun Crater Rim (2,639 m)</strong>. The team prepares the campsite while you enjoy the spectacular mountain views." },
      { time: "06:30 PM", text: "Enjoy a freshly prepared dinner while watching the sunset, followed by stargazing and overnight camping at the crater rim." },
    ],
  },
  {
    day: "Day 2",
    title: "Day 2: Mount Rinjani Summit Trek – Sunrise & Segara Anak Lake",
    paragraphs: [
      "Your second day begins in the early hours of the morning as you prepare for the challenging ascent to <strong>Mount Rinjani Summit (3,726 m)</strong>. Under a sky filled with stars, you will begin your summit adventure accompanied by your experienced trekking guide.",
      "After a wake-up call from your trekking team, enjoy a light breakfast before preparing for the summit climb. Your guide will accompany you throughout the ascent, helping you maintain a steady pace along the challenging volcanic trail.",
      "Reaching the summit at sunrise rewards you with spectacular sunrise views across <strong>Lombok, Bali, Sumbawa, and Segara Anak Lake</strong>. Take time to appreciate the incredible scenery and celebrate this unforgettable achievement.",
      "After enjoying the summit and taking photographs, begin descending towards Sembalun Crater Rim campsite. Upon arrival, enjoy a freshly prepared breakfast and take some time to rest before continuing the journey.",
      "The adventure then continues downhill towards <strong>Segara Anak Lake</strong>, passing through the dramatic volcanic landscape of Mount Rinjani. Your guide will accompany you along the trail, while your porter team assists with the trekking equipment and camping arrangements.",
      "Upon reaching Segara Anak Lake, enjoy a freshly prepared lunch from the Asgard Rinjani Trekking team. Surrounded by beautiful volcanic scenery and the peaceful atmosphere of the crater lake, this is the perfect opportunity to relax and recover after the summit climb.",
      "In the afternoon, enjoy some free time around the lake. You can explore the surrounding area, relax beside the water, or visit the nearby <strong>natural hot springs</strong>, subject to prevailing conditions and applicable park guidance.",
      "Your trekking team will prepare the lakeside campsite for the night. Enjoy dinner and experience another memorable evening surrounded by Mount Rinjani's spectacular volcanic landscape.",
    ],
    timeline: [
      { time: "02:00 AM", text: "Wake-up call and preparation for the summit trek." },
      { time: "02:30 AM", text: "Begin the ascent to Mount Rinjani Summit." },
      { time: "05:30 AM", text: "Reach the summit <strong>(3,726 m)</strong> for sunrise and panoramic views." },
      { time: "07:00 AM", text: "Begin descending towards Sembalun Crater Rim campsite." },
      { time: "09:00 AM", text: "Enjoy a freshly prepared breakfast at camp." },
      { time: "10:00 AM", text: "Begin descending towards Segara Anak Lake." },
