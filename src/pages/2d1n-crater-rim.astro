---
import Layout from "../layouts/Layout.astro";
import PackageDetailFrame from "../components/PackageDetailFrame.astro";
import { site, whatsappLink } from "../data/site";

const title = "Mount Rinjani Senaru Crater Rim Trekking \u2013 2 Days 1 Night";
const bookingHref = whatsappLink(
  "Hello Asgard Rinjani Trekking, I would like to enquire about the Mount Rinjani Senaru Crater Rim Trekking \u2013 2 Days 1 Night. Please share current availability, the confirmed itinerary, difficulty guidance, and package details.",
);

const highlights = [
  "A two-day, one-night Senaru-to-Senaru trekking journey",
  "An overnight camp at Plawangan Senaru, subject to current operating conditions",
  "Panoramic views of Segara Anak Lake and Mount Rinjani from Senaru Crater Rim",
  "A return descent through Senaru's tropical forest",
];

const itinerary = [
  {
    day: "Day 0",
    title: "Arrival in Senaru & Pre-Trek Preparation",
    intro: "Day 0 is reserved for arriving in Senaru and preparing for the Senaru Crater Rim trek. The pick-up schedule and estimated transfer times below can help you plan your journey; please confirm with Asgard Rinjani Trekking whether transport from your location is included in your booking and coordinate the arrangements with the team. Pre-trek accommodation in Senaru is not included in the package price, so please arrange your own stay unless separate arrangements have been confirmed.",
    pickupSchedule: [
      { location: "Kuta Lombok", time: "09:00 AM or 04:00–05:00 PM" },
      { location: "Senggigi / Mataram", time: "10:00–11:00 AM or 04:00 PM" },
      { location: "Tetebatu / Pringgasela", time: "09:00–10:00 AM" },
      { location: "Bangsal Harbor / Gili Islands", time: "Around 11:30 AM (following your boat arrival)" },
    ],
    recommendation: "If a morning transfer is available and included in your confirmed booking, we recommend choosing it where possible. This allows time to relax, explore Senaru Village and rest before the trek.",
    transferTimes: [
      { location: "Lombok International Airport (LOP) / Lembar Harbor", time: "Approximately 3.5 hours" },
      { location: "Mataram / Senggigi", time: "Approximately 2 hours" },
      { location: "Bangsal Harbor", time: "Approximately 1 hour 25 minutes" },
      { location: "Kuta Lombok / Tetebatu", time: "Approximately 4 hours" },
      { location: "Labuan Lombok (Kayangan Harbor)", time: "Approximately 2 hours" },
    ],
    accommodation: "Pre-trek accommodation in Senaru is not included in the trekking package price. Guests are responsible for arranging their own stay unless separate arrangements have been made. If included in your confirmed package, the evening preparation may include a trekking guide briefing, equipment inspection and overview of the adventure; coordinate the details with the team.",
    details: [
    ],
    summary: [],
  },
  {
    day: "Day 1",
    title: "Senaru Village to Senaru Crater Rim (2,641 m)",
    intro: "The first trekking day begins with breakfast and trekking preparation in Senaru, followed by the scheduled transfer to Senaru Trekking Gate. From the 08:00 AM start, follow the route through Senaru's tropical forest, with planned stops at Pos 1, Pos 2 and Pos 3; lunch is scheduled at Pos 3 (2,000 m). Continue toward Senaru Crater Rim, reaching 2,641 m within the listed 04:00–05:00 PM arrival window. The afternoon brings sunset and free time before dinner and overnight camping at the rim. Your guide and team coordinate the day's preparations and progress along the route.",
    pickupSchedule: [],
    recommendation: "",
    transferTimes: [],
    accommodation: "",
    details: [
      "07:00 AM — Breakfast & Trekking Preparation",
      "07:30 AM — Transfer to Senaru Trekking Gate",
      "08:00 AM — Start Trekking",
      "10:00 AM — Rest at Pos 1 (915 m)",
      "12:00 PM — Pos 2 (1,500 m)",
      "01:00 PM — Lunch at Pos 3 (2,000 m)",
      "02:00 PM — Continue Toward the Crater Rim",
      "04:00–05:00 PM — Arrive at Senaru Crater Rim (2,641 m)",
      "05:30 PM — Sunset & Free Time",
      "07:00 PM — Dinner & Overnight Camping",
    ],
    summary: ["Overnight: Senaru Crater Rim", "Meals: Breakfast, Lunch & Dinner"],
  },
  {
    day: "Day 2",
    title: "Senaru Crater Rim to Senaru Village",
    intro: "Begin the day with sunrise and morning views from Senaru Crater Rim, followed by breakfast before the scheduled 08:00 AM descent. Return along the Senaru route with the listed rest and lunch breaks, then continue toward Senaru Village at 01:00 PM. Arrival is scheduled for approximately 02:30–03:30 PM. Breakfast and lunch are listed for this day; any onward drop-off or transfer is subject to the inclusions confirmed for your package.",
    pickupSchedule: [],
    recommendation: "",
    transferTimes: [],
    accommodation: "",
    details: [
      "06:00 AM — Sunrise & Morning Views",
      "07:00 AM — Breakfast",
      "08:00 AM — Begin Descent",
      "10:00 AM — Rest Break",
      "12:00 PM — Lunch Break",
      "01:00 PM — Continue to Senaru Village",
      "02:30–03:30 PM — Arrive at Senaru Village",
    ],
    summary: ["Meals: Breakfast & Lunch", "Trek Ends: Approximately 02:30–03:30 PM"],
  },
];

const gallery = [
  { src: "/asgard-rinjani-trekking/images/senaru08.jpg", alt: "Mount Rinjani landscape on the Senaru Crater Rim route" },
  { src: "/asgard-rinjani-trekking/images/senaru21.jpg", alt: "Senaru forest trail on the Mount Rinjani trek" },
  { src: "/asgard-rinjani-trekking/images/senaru12.jpg", alt: "View across Mount Rinjani from the Senaru route" },
];

const details = [
  { label: "Duration", value: "2 Days · 1 Night" },
  { label: "Starting point", value: "Senaru trekking starting point" },
  { label: "Finishing point", value: "Senaru trekking starting point" },
  { label: "Difficulty", value: "To be confirmed with your guide" },
  { label: "Maximum elevation", value: "Confirm with the team for your dates" },
  { label: "Camping location", value: "Plawangan Senaru, subject to operating confirmation" },
];

const inclusionGroups = [
  {
    title: "Trekking Services",
    items: [
      "Professional trekking guide and porter support for shared camping equipment, food, and cooking supplies throughout the trek.",
      "Mount Rinjani National Park permits and entrance tickets, as confirmed for your departure.",
      "Round-trip trekking transfers: Transfer from the Senaru meeting point to Senaru Trekking Gate on Day 1, and return transfer from Senaru Village trekking exit to the Senaru meeting point on Day 2.",
    ],
  },
  {
    title: "Meals and Drinks",
    items: [
      "Meals shown in the itinerary: Day 1 lunch and dinner; Day 2 breakfast and lunch.",
      "Drinking water, fresh fruit, tea, and coffee during the trek, subject to the final written package confirmation.",
    ],
  },
  {
    title: "Camping Equipment",
    items: [
      "Mountain camping equipment for one overnight camp, including tents, sleeping bags, mattresses, and pillows.",
      "Shared cooking and dining equipment and a portable toilet tent at camp, subject to the final written package confirmation.",
    ],
  },
  {
    title: "Complimentary Trekking Equipment",
    items: [
      "Warm jackets, trekking poles, headlamps, and gloves may be available to borrow at no extra charge, subject to availability. Request items in advance and confirm availability with Asgard Rinjani Trekking.",
    ],
  },
];

const exclusionGroups = [
  {
    title: "Personal Expenses",
    items: [
      "Personal purchases and expenses not listed in the confirmed package inclusions or trek itinerary.",
    ],
  },
  {
    title: "Personal Trekking Equipment",
    items: [
      "Personal clothing, footwear, and trekking equipment. Complimentary equipment loans, if available, are limited to the items and availability confirmed by the team.",
    ],
  },
  {
    title: "Accommodation",
    items: [
      "Accommodation before and after the trekking program is not included in the package price. Guests are responsible for arranging their own hotel or guesthouse in Lombok. If you need accommodation recommendations, please contact our team in advance.",
    ],
  },
  {
    title: "Tips and Gratuities",
    items: [
      "Tips or gratuities for guides, porters, drivers, or other service providers are not included and are at the guest’s discretion.",
    ],
  },
  {
    title: "Other Exclusions",
    items: [
      "Flights to and from Lombok, travel insurance, personal luggage porter service, and any service or cost not expressly listed in the confirmed package inclusions.",
    ],
  },
];

const faqs = [
  { question: "What is the Senaru Crater Rim route?", answer: "This two-day itinerary starts and finishes at the Senaru trekking starting point. It ascends through Senaru's tropical forest to Plawangan Senaru and descends by the same route on day two." },
  { question: "Will we visit Segara Anak Lake?", answer: "No. The lake is viewed from Senaru Crater Rim; this itinerary does not include a descent to or visit at Segara Anak Lake." },
  { question: "How difficult is the 2 Days 1 Night Senaru Crater Rim Trek?", answer: "The route involves sustained uphill and downhill walking at altitude. Confirm current difficulty guidance and whether this trek suits your experience with the Asgard team before booking." },
  { question: "Where does the Senaru Crater Rim Trek start and finish?", answer: "The trek starts and finishes at the Senaru trekking starting point, following the same Senaru route back down. Any hotel transfers depend on the arrangement confirmed for your booking." },
  { question: "Do I need previous trekking experience?", answer: "Previous trekking experience can be helpful. Prepare physically and discuss your experience and fitness with the trekking team when planning." },
  { question: "What should I bring for the Senaru Crater Rim trek?", answer: "Bring suitable trekking clothing, comfortable hiking footwear, personal essentials, and the equipment listed in the confirmed packing list." },
  { question: "Where will we camp overnight?", answer: "The planned overnight camp is at Plawangan Senaru, subject to current operating conditions and final confirmation with the team." },
  { question: "Are meals and camping equipment included?", answer: "Please refer to the confirmed package inclusions or contact Asgard Rinjani Trekking for the latest details before booking." },
  { question: "What happens if the weather is bad?", answer: "The itinerary may be adjusted depending on weather conditions, mountain safety, and applicable national park regulations." },
];
---

<Layout title="Senaru Crater Rim Trek | 2 Days, 1 Night | Asgard Rinjani" description="Climb through Senaru’s forest to camp at Plawangan Senaru, with views of Segara Anak Lake and Mount Rinjani. Explore this 2-day trek and its booking options." ogImage="/asgard-rinjani-trekking/images/optimized/package-senaru09.webp" ogImageAlt="Mount Rinjani and Segara Anak Lake viewed from the Senaru Crater Rim">
  <PackageDetailFrame title={title} heading={"Senaru Crater Rim"} route={"Senaru Village · Senaru Crater Rim · Senaru Village"} subtitle={"Two days. One night. A forest ascent to Plawangan Senaru."} note={"See Segara Anak Lake and Mount Rinjani from the rim; this trek does not descend to the lake."} heroImage={"/asgard-rinjani-trekking/images/optimized/package-senaru09.webp"} heroAlt={"Mount Rinjani and Segara Anak Lake viewed from the Senaru Crater Rim"} bookingHref={bookingHref} details={details} gallery={gallery} galleryTitle={"Senaru and the crater, in view."} galleryDescription={"Forest trails and the volcanic panorama seen from Senaru Crater Rim."}>

    <section class="section overview" id="overview" aria-labelledby="overview-title">
      <div class="container">
        <div class="section-intro">
          <p class="eyebrow">The journey</p>
          <h2 class="section-heading" id="overview-title">A Senaru journey to <em>the rim.</em></h2>
          <p class="section-copy">Trek from Senaru through tropical forest to Plawangan Senaru and camp overnight at the rim, with views of Segara Anak Lake and Mount Rinjani. Descend by the same route on day two; transfers, meals, and operating details are confirmed with our team.</p>
        </div>
        <dl class="trip-facts">
          {details.map((item) => <div class="fact"><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
        <div class="highlights">
          <div><p class="eyebrow">At a glance</p><h3>Senaru forest to <em>crater rim.</em></h3></div>
          <ul>{highlights.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section facilities" aria-labelledby="facilities-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Plan with clarity</p><h2 class="section-heading" id="facilities-title"><em>Inclusions.</em></h2><p class="section-copy">Review the services and equipment associated with the trek. Confirm the final written inclusions for your dates and selected booking option before departure.</p></div>
        <p class="inclusion-note">Transfers between the Senaru meeting point and the Senaru trekking trail points are part of the trekking package. Transportation between other Lombok locations and Senaru is included only when the Trek + Transportation booking option is selected and confirmed. Day 0 accommodation is arranged separately unless an additional service is confirmed in writing.</p>
        <div class="facility-grid">{inclusionGroups.map((group) => <article><span class="facility-mark" aria-hidden="true">✓</span><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
        <div class="section-intro inclusion-subheading"><p class="eyebrow">Plan with clarity</p><h2 class="section-heading"><em>Exclusions.</em></h2><p class="section-copy">The following items are not included unless they are specifically confirmed in writing with your booking.</p></div>
        <div class="facility-grid">{exclusionGroups.map((group) => <article><span class="facility-mark" aria-hidden="true">–</span><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
      </div>
    </section>

<section class="section itinerary" id="itinerary" aria-labelledby="itinerary-title">
      <div class="container">
        <div class="section-intro centered">
          <p class="eyebrow">Your journey, day by day</p>
          <h2 class="section-heading" id="itinerary-title">Route <em>Day by Day.</em></h2>
          <p class="section-copy">From your arrival in Senaru to the return from the crater rim, follow the planned journey below.</p>
          <p class="itinerary-timing-note"><strong>Important Note</strong> All timing is approximate and may vary depending on weather, trail conditions, group pace and rest breaks.</p>
        </div>
        <ol class="day-list">
          {itinerary.map((item) => (
            <li class:list={["day-card", item.day === "Day 0" && "day-card-arrival"]}>
              <span class="day-index">{item.day}</span>
              <div class="day-card-content">
                <h3>{item.title}</h3>
                {item.day === "Day 0" ? (
                  <>
                    <p class="arrival-intro">{item.intro}</p>
                    <div class="arrival-panels">
                      <section class="arrival-panel" aria-labelledby="pickup-schedule-title">
                        <h4 id="pickup-schedule-title"><span class="arrival-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M3 16.5h18M5 16.5V12l2-5h10l2 5v4.5M7 16.5v2m10-2v2M7 12h10M8.5 9h7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7.5" cy="16.5" r="1" fill="currentColor"/><circle cx="16.5" cy="16.5" r="1" fill="currentColor"/></svg></span>Pick-Up Schedule</h4>
                        <ul class="arrival-list">{item.pickupSchedule.map((entry) => <li><strong>{entry.location}</strong><span>{entry.time}</span></li>)}</ul>
                      </section>
                      <section class="arrival-panel" aria-labelledby="transfer-times-title">
                        <h4 id="transfer-times-title"><span class="arrival-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Estimated Transfer Times</h4>
                        <ul class="arrival-list">{item.transferTimes.map((entry) => <li><strong>{entry.location}</strong><span>{entry.time}</span></li>)}</ul>
                      </section>
                    </div>
                    <aside class="arrival-recommendation"><span class="recommendation-label">Our Recommendation</span><p>{item.recommendation}</p></aside>
                    <section class="arrival-accommodation" aria-labelledby="overnight-accommodation-title">
                      <h4 id="overnight-accommodation-title"><span class="arrival-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M3.5 19V8.5L12 4l8.5 4.5V19M2.5 19h19M7 19v-6h10v6M9 10h.01M15 10h.01" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Pre-Trek Accommodation &amp; Briefing</h4>
                      <p>{item.accommodation}</p>
                    </section>
                  </>
                ) : (
                  <>
                    <p class="day-description">{item.intro}</p>
                    <div class="itinerary-timeline">{item.details.map((detail) => { const separator = detail.indexOf(" — "); return <p class="itinerary-entry">{separator >= 0 ? <><strong>{detail.slice(0, separator)}</strong><span>{detail.slice(separator + 3)}</span></> : detail}</p>; })}</div>
                    <div class="itinerary-summary">{item.summary.map((fact) => <p><strong>{fact.slice(0, fact.indexOf(":") + 1)}</strong>{fact.slice(fact.indexOf(":") + 1)}</p>)}</div>
                  </>
                )}
              </div>
              <span class="day-mark" aria-hidden="true">→</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    

    

        <section class="section trekking-info" id="trekking-info" aria-labelledby="trekking-info-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Plan with confidence</p><h2 class="section-heading" id="trekking-info-title">Important Information <em>Before Your Trek.</em></h2><p class="section-copy">Routes, schedules, and operating plans can change with mountain conditions and park guidance. Confirm the final meeting point, route, camping plan, packing list, and package arrangements with our team before departure.</p></div>
        <div class="info-grid">
          <article><span class="info-label">What to Bring</span><p>Bring suitable trekking clothing, comfortable hiking footwear, personal essentials, and all items listed in the confirmed packing list. Ask the team for the route-specific list before departure.</p></article>
          <article><span class="info-label">Free Trekking Equipment</span><p>At Asgard Rinjani Trekking, we want every guest to feel comfortable and well-prepared throughout their Mount Rinjani adventure.</p><p>To help make your trekking experience more convenient, we provide complimentary equipment loans for the following items, subject to availability:</p><ul class="equipment-loan-list"><li>Warm trekking jackets.</li><li>Trekking poles.</li><li>Headlamps.</li><li>Gloves.</li><li>All other equipment listed in the Inclusions section.</li></ul><p>Guests who require any of these items are encouraged to inform our team in advance so we can check availability and prepare the equipment before departure.</p><p>Please note that these items are provided as complimentary loans and must be returned to our team after the trekking program.</p><p>We recommend bringing your own personal trekking shoes, comfortable hiking clothes, and other essential personal equipment.</p></article>
          <article><span class="info-label">Additional Information</span><p>This two-day route climbs from the Senaru trekking starting point through tropical forest to Plawangan Senaru, then returns by the same route. Expect sustained uphill and downhill walking; discuss your fitness and trekking experience with the team while planning.</p><p>Segara Anak Lake and Mount Rinjani are viewed from the crater rim. The itinerary does not descend to the lake. The planned overnight camp at Plawangan Senaru and daily arrangements remain subject to operating conditions and confirmation.</p><p>Weather, trail conditions, safety guidance, and Mount Rinjani National Park regulations may affect the schedule or route. Confirm current guidance and the final meeting arrangements before departure.</p></article>
          <article><span class="info-label">Why Choose Asgard Rinjani Trekking?</span><p>Plan your Mount Rinjani journey with a local Lombok trekking team. Contact us for route-specific preparation guidance and to confirm the arrangements for your dates.</p></article>
        </div>
      </div>
    </section><section class="section faq" aria-labelledby="faq-title">
      <div class="container faq-container">
        <header class="faq-heading">
          <p class="eyebrow">Frequently Asked Questions</p>
          <h2 class="section-heading" id="faq-title">Everything You Need to <em>Know.</em></h2>
          <p class="section-copy">Helpful details for preparing for the Senaru Crater Rim Trek.</p>
        </header>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <article class="faq-item">
              <h3>
                <button class="faq-trigger" type="button" id={`faq-trigger-${index}`} aria-expanded="false" aria-controls={`faq-panel-${index}`}>
                  <span>{faq.question}</span><span class="faq-icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="faq-panel" id={`faq-panel-${index}`} role="region" aria-labelledby={`faq-trigger-${index}`} aria-hidden="true" inert>
                <div class="faq-panel-inner"><p>{faq.answer}</p></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="route-showcase" aria-labelledby="route-showcase-title">
      <div class="container route-showcase-container">
        <header class="route-showcase-heading">
          <p class="eyebrow">EXPLORE MOUNT RINJANI</p>
          <h2 class="section-heading" id="route-showcase-title">Explore Your Rinjani Route</h2>
          <p class="section-copy">Follow Senaru’s forest trail to Plawangan Senaru, where sweeping views open across Segara Anak Lake and Mount Rinjani.</p>
        </header>
        <figure class="route-showcase-map">
          <img src="/asgard-rinjani-trekking/images/rinjani%20map/Senaru%20Route%20Crater%20Rim%20Trek%20Map.png" alt="Senaru Crater Rim Trek route map" loading="lazy" decoding="async" />
        </figure>
        <p class="route-showcase-caption">Senaru Route – Crater Rim Trek</p>
      </div>
    </section>
  </PackageDetailFrame>
</Layout>

<style>
  .hero{position:relative;min-height:min(850px,100svh);min-height:max(690px,92svh);display:flex;align-items:center;overflow:hidden;background:#080908;padding:calc(var(--header-h) + 72px) 0 100px}
  .hero-image,.hero-shade{position:absolute;inset:0;width:100%;height:100%}.hero-image{object-fit:cover;object-position:center 48%;animation:reveal 1.5s ease both}.hero-shade{background:linear-gradient(90deg,rgba(5,6,5,.85),rgba(5,6,5,.45) 58%,rgba(5,6,5,.08)),linear-gradient(0deg,#080908 0%,transparent 45%,rgba(4,5,4,.2))}
  .hero-content{position:relative;z-index:1;max-width:1180px;animation:rise .9s .12s both}.hero h1{font:500 clamp(4.4rem,10vw,9rem)/.88 var(--font-display);letter-spacing:-.045em;color:#fff;margin:0 0 25px}.hero h1 em,.section-heading em,.highlights h3 em{color:var(--gold-soft);font-weight:500}.hero-subtitle{max-width:590px;color:#eee7d9;font:400 clamp(1.25rem,2.4vw,1.7rem)/1.45 var(--font-display);margin:0 0 10px}.hero-note{font-size:.82rem;color:#c0baae;margin:0 0 27px}.actions{display:flex;gap:13px;flex-wrap:wrap}.actions .btn{min-height:54px}.scroll-cue{position:absolute;z-index:1;bottom:32px;left:max(5vw,calc((100vw - 1180px)/2));display:flex;gap:12px;align-items:center;color:#e6dfd1;text-decoration:none;text-transform:uppercase;font-size:.63rem;letter-spacing:.2em}.scroll-cue span{width:1px;height:34px;background:var(--gold)}
  .section{padding:64px 0}.overview{background:#0b0c0b}.section-intro{max-width:700px;margin-bottom:30px}.section-heading{font-size:clamp(2.8rem,5vw,4.8rem);margin-bottom:18px}.trip-facts{display:grid;grid-template-columns:repeat(4,1fr);margin:0;border-block:1px solid var(--line)}.fact{padding:23px 20px 25px 0}.fact dt{font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:8px}.fact dd{margin:0;color:var(--cream);font:500 1.35rem/1.25 var(--font-display)}
  .highlights{display:grid;grid-template-columns:.85fr 1.15fr;gap:8%;align-items:center;padding-top:40px}.highlights h3{font:500 clamp(2.15rem,4vw,3.5rem)/1.08 var(--font-display);color:var(--cream);margin:0;max-width:390px}.highlights ul{list-style:none;margin:0;padding:0}.highlights li{display:flex;gap:15px;padding:15px 0;border-bottom:1px solid rgba(255,255,255,.09);color:#d0c9bc}.highlights li span{color:var(--gold);font-size:.85rem}
