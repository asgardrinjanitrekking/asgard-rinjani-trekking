---
import Layout from "../layouts/Layout.astro";
import PackageCard from "../components/PackageCard.astro";
import { site, whatsappLink } from "../data/site";
import { getGalleryImageVariants } from "../data/galleryImageVariants";

const packages = [
  { bookingId: "torean", title: "Torean Traverse", duration: "3 Days 2 Nights", route: "Sembalun \u00B7 Summit \u00B7 Segara Anak \u00B7 Torean", summary: "An unforgettable journey across Rinjani's spectacular landscapes, from summit dawn to the sacred crater lake and the dramatic Torean descent.", difficulty: "Challenging", image: "/asgard-rinjani-trekking/images/optimized/package-trn10.webp", detailHref: "/asgard-rinjani-trekking/3d2n-torean/" },
  { bookingId: "senaru-crater-rim", title: "Senaru Crater Rim Trekking", duration: "2 Days 1 Night", route: "Senaru Crater Rim", summary: "Trek through Senaru's tropical forest to camp at Plawangan Senaru, with sweeping views over Segara Anak Lake and Mount Rinjani.", difficulty: "Moderate", image: "/asgard-rinjani-trekking/images/optimized/package-senaru09.webp", detailHref: "/asgard-rinjani-trekking/2d1n-crater-rim/" },
  { bookingId: "second-summit", title: "Second Summit", duration: "2 Days 1 Night", route: "Second Summit Route", summary: "Discover another incredible mountain adventure with spectacular views and a quieter ridgeline experience.", difficulty: "Moderate to challenging", image: "/asgard-rinjani-trekking/images/optimized/package-ss03.webp", detailHref: "/asgard-rinjani-trekking/2d1n-second-summit/" },
  { bookingId: "summit", title: "Summit Trekking", duration: "2 Days 1 Night", route: "Sembalun to Summit", summary: "Challenge yourself to experience the breathtaking summit of Mount Rinjani, standing 3,726 metres above the island of Lombok.", difficulty: "Challenging", image: "/asgard-rinjani-trekking/images/optimized/package-summit12.webp", detailHref: "/asgard-rinjani-trekking/2d1n-summit/" },
  { bookingId: "sembalun-senaru", title: "Sembalun \u2013 Senaru", duration: "3 Days 2 Nights", route: "Sembalun \u00B7 Summit \u00B7 Senaru", summary: "Explore Rinjani through two iconic trekking routes, crossing the crater and completing the classic traverse of the mountain.", difficulty: "Challenging", image: "/asgard-rinjani-trekking/images/optimized/package-smbln05.webp", detailHref: "/asgard-rinjani-trekking/3d2n-sembalun-senaru/" },
  { bookingId: "4d3n-rinjani", title: "Grand Rinjani", duration: "4 Days 3 Nights", route: "Extended Mount Rinjani", summary: "An extended Mount Rinjani adventure to discover its extraordinary natural beauty, with more time at the lake, hot springs, and rim.", difficulty: "Challenging", image: "/asgard-rinjani-trekking/images/optimized/package-trn03.webp", detailHref: "/asgard-rinjani-trekking/4d3n-rinjani/" },
];

const heroSlides = [
  { src: "/asgard-rinjani-trekking/images/optimized/hero-hotsprings02.webp", alt: "Natural hot springs beside Segara Anak Lake" },
  { src: "/asgard-rinjani-trekking/images/optimized/hero-senaru02.webp", alt: "Mountain scenery along the Senaru trekking route" },
  { src: "/asgard-rinjani-trekking/images/optimized/hero-trn08.webp", alt: "Mount Rinjani landscape along the Torean traverse" },
  { src: "/asgard-rinjani-trekking/images/optimized/hero-smbln04.webp", alt: "Open highlands along the Sembalun trekking route" },
  { src: "/asgard-rinjani-trekking/images/optimized/hero-smbln02.webp", alt: "Mountain panorama in the Sembalun highlands" },
];

const gallery = [
  { src: "/asgard-rinjani-trekking/images/summit.jpg", alt: "Mount Rinjani summit ridge above the clouds", shape: "gallery-tall" },
  { src: "/asgard-rinjani-trekking/images/gallery-segara-anak.jpg", alt: "Segara Anak crater lake from the Rinjani rim", shape: "" },
  { src: `${import.meta.env.BASE_URL}/images/gallery-crater-sunset.jpg`, alt: "Sunset light over Segara Anak", shape: "" },
  { src: "/asgard-rinjani-trekking/images/rinjani-wiki-3.jpg", alt: "Barujari cone rising from Segara Anak lake", shape: "" },
  { src: "/asgard-rinjani-trekking/images/rinjani-wiki-1.jpg", alt: "Trekker on the Rinjani summit with crater views", shape: "" },
  { src: "/asgard-rinjani-trekking/images/rinjani-wiki-2.jpg", alt: "Clouds moving across the Rinjani slopes", shape: "" },
  { src: "/asgard-rinjani-trekking/images/danau01.jpg", alt: "Wide view across Segara Anak Lake in Rinjani's volcanic caldera", shape: "" },
  { src: "/asgard-rinjani-trekking/images/danau03.jpg", alt: "Mountain scenery surrounding the waters of Segara Anak", shape: "" },
  { src: "/asgard-rinjani-trekking/images/danau06.jpg", alt: "Rinjani crater lake framed by steep volcanic slopes", shape: "" },
  { src: "/asgard-rinjani-trekking/images/hotsprings01.jpg", alt: "Natural hot springs beside Segara Anak Lake", shape: "" },
  { src: "/asgard-rinjani-trekking/images/hotsprings03.jpg", alt: "Trekking guests relaxing at Rinjani's natural hot springs", shape: "" },
  { src: "/asgard-rinjani-trekking/images/smbln03.jpg", alt: "Trekking trail crossing the open highlands of Sembalun", shape: "" },
  { src: "/asgard-rinjani-trekking/images/senaru03.jpg", alt: "Green mountain landscape along the Senaru trekking route", shape: "" },
  { src: "/asgard-rinjani-trekking/images/summit03.jpg", alt: "Trekker making the final ascent toward Mount Rinjani's summit", shape: "" },
  { src: "/asgard-rinjani-trekking/images/adat01.jpg", alt: "Traditional Sasak culture in Lombok, home of Mount Rinjani", shape: "" },
  { src: "/asgard-rinjani-trekking/images/food01.jpg", alt: "A freshly prepared meal shared during a Rinjani trekking trip", shape: "" },
  { src: "/asgard-rinjani-trekking/images/ss01.jpg", alt: "Mount Rinjani trekking landscape on the Second Summit route", shape: "" },
];

const trekFeatures = [
  { title: "Experienced Guide & Porter Team", description: "Local support throughout your trekking journey.", icon: "guide" },
  { title: "Trekking & Camping Equipment", description: "Essential equipment prepared for your mountain adventure.", icon: "equipment" },
  { title: "Meals During the Trek", description: "Meals prepared during your trekking itinerary.", icon: "meals" },
  { title: "Drinking Water", description: "Drinking water arrangements for your trekking journey.", icon: "water" },
  { title: "National Park Permit", description: "Permit arrangements according to the selected package.", icon: "permit" },
  { title: "Pre-Trek Accommodation", description: "Pre-trek accommodation depending on your selected service.", icon: "accommodation" },
  { title: "Airport / Hotel Transfers", description: "Transport arrangements can be discussed with our team.", icon: "transfer" },
  { title: "Luggage Storage", description: "Luggage storage arrangements during your trek.", icon: "luggage" },
  { title: "Trekking Preparation & Briefing", description: "Prepare for your Rinjani adventure with guidance from our local team.", icon: "briefing" },
];
---

<Layout title="Mount Rinjani Trekking in Lombok | Asgard Rinjani" description="Plan a Mount Rinjani trek with a local Lombok team. Compare summit, crater rim, Segara Anak Lake and Torean routes, then choose the journey that suits you." ogImage="/asgard-rinjani-trekking/images/optimized/hero-hotsprings02.webp" ogImageAlt="Natural hot springs beside Segara Anak Lake on Mount Rinjani">
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-slides" aria-hidden="true">
        {heroSlides.map((slide, index) => (
          <img
            class:list={["hero-image", index === 0 && "is-active"]}
            src={slide.src}
            alt={slide.alt}
            fetchpriority={index === 0 ? "high" : "auto"}
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
            width="2400"
            height="1600"
          />
        ))}
      </div>
      <div class="hero-overlay" aria-hidden="true"></div>
      <div class="container hero-content">
        <p class="eyebrow hero-eyebrow">Lombok &middot; Indonesia <span></span><span class="hero-elevation">3,726&nbsp;m</span></p>
        <h1 id="hero-title">Above the ordinary.<br /><em>Into the wild.</em></h1>
        <p class="description">Discover Mount Rinjani with {site.name}. A remarkable mountain, a thoughtful local team, and a journey that stays with you.</p>
        <div class="hero-actions">
          <a class="btn btn-gold" href="#packages">Discover the journeys <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10h13m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          <a class="btn btn-ghost" href="#about">About Us</a>
        </div>
      </div>
      <a class="hero-scroll" href="#introduction"><span></span>Scroll to explore</a>
      <p class="hero-index" aria-hidden="true">01 <span></span> 07</p>
    </section>

    <section class="intro section" id="introduction">
      <div class="container intro-grid">
        <div class="intro-title">
          <p class="eyebrow">Welcome to Asgard</p>
          <h2 class="section-heading">A mountain of<br /><em>another world.</em></h2>
          <div class="gold-rule" style="margin-left:0"></div>
        </div>
        <div class="intro-copy">
          <p>Some journeys are measured in distance. The best ones are measured in what they leave behind.</p>
          <p>From Sembalun's open highlands to the still waters of Segara Anak, Rinjani reveals a different world with every step. We are here to help you experience it with care, confidence, and a deep respect for the mountain.</p>
          <a class="text-link" href="#about">Meet your local team <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M6 5h9v9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </div>
      </div>
    </section>

    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="container about-layout">
        <figure class="about-visual">
          <img class="about-photo" src="/asgard-rinjani-trekking/images/optimized/gallery/senaru01-800.webp" srcset="/asgard-rinjani-trekking/images/optimized/gallery/senaru01-800.webp 800w, /asgard-rinjani-trekking/images/optimized/gallery/senaru01-2200.webp 2200w" sizes="(max-width: 760px) calc(100vw - 36px), (max-width: 1100px) 45vw, 42vw" alt="Local trekking team and guests gathered at a mountain campsite at sunset" loading="lazy" decoding="async" width="800" height="450" />
          <figcaption class="about-photo-caption"><span>Rinjani, shared</span><span>Lombok, Indonesia</span></figcaption>
        </figure>

        <div class="about-content">
          <header class="about-intro">
            <p class="eyebrow">Local knowledge. Meaningful journeys.</p>
            <h2 class="section-heading" id="about-title">About Asgard<br /><em>Rinjani Trekking</em></h2>
            <p class="section-copy">We are a local trekking team from Lombok, Indonesia, dedicated to creating unforgettable Mount Rinjani adventures through authentic experiences, professional guidance, and responsible tourism.</p>
          </header>

          <div class="about-features">
            <article class="about-feature">
              <span class="about-feature-number">01</span>
              <h3>Experienced Local Trekking Guide</h3>
              <p>Explore Mount Rinjani with experienced local guides who know the mountain, its trails, and local culture.</p>
            </article>
            <article class="about-feature">
              <span class="about-feature-number">02</span>
              <h3>Small Group Trekking Experience</h3>
              <p>Enjoy a more personal trekking experience with small groups and better attention throughout your journey.</p>
            </article>
            <article class="about-feature">
              <span class="about-feature-number">03</span>
              <h3>Eco-Friendly &amp; Responsible Trekking</h3>
              <p>We respect nature, minimize waste, and promote responsible trekking practices to protect Mount Rinjani.</p>
            </article>
            <article class="about-feature">
              <span class="about-feature-number">04</span>
              <h3>Personal Service</h3>
              <p>Every journey is different. We organize trekking experiences according to your needs and preferences.</p>
            </article>
          </div>

          <div class="about-closing">
            <span class="about-closing-mark" aria-hidden="true"></span>
            <div>
              <p class="eyebrow">Your mountain story begins here</p>
              <h3>Explore Mount Rinjani <em>With Us</em></h3>
              <p>Discover breathtaking landscapes, unforgettable adventures, and the beauty of Mount Rinjani with our local trekking team.</p>
            </div>
            <a class="about-closing-link" href="#packages" aria-label="Explore Mount Rinjani trekking packages"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M6 5h9v9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </div>
        </div>
      </div>
    </section>

    <section class="section packages" id="packages">
      <div class="container">
        <div class="section-header">
          <div><p class="eyebrow">Find your way up</p><h2 class="section-heading">Journeys into <em>Rinjani.</em></h2></div>
          <p class="section-copy">Six ways to experience the mountain, from a crater-rim escape to a full traverse through its most unforgettable landscapes.</p>
          <div class="gold-rule"></div>
        </div>
        <div class="package-grid">{packages.map((item) => <PackageCard {...item} />)}</div>
      </div>
    </section>

    <section class="section reasons" aria-labelledby="reasons-heading">
      <div class="container">
        <div class="section-header"><p class="eyebrow">Why Asgard</p><h2 class="section-heading" id="reasons-heading">The difference is <em>in every detail.</em></h2></div>
        <div class="reason-grid">
          <article><span class="reason-number">01 / LOCAL KNOWLEDGE</span><h3>At home on the mountain</h3><p>Guides from Lombok who read weather, trail, and tempo with lived experience.</p></article>
          <article><span class="reason-number">02 / THOUGHTFUL PACE</span><h3>Summit with intention</h3><p>Carefully timed departures, acclimatisation, and support for the 3,726 m ascent.</p></article>
          <article><span class="reason-number">03 / CONSIDERED COMFORT</span><h3>Room to take it in</h3><p>Refined camp details, generous meals, and an unhurried mountain rhythm.</p></article>
        </div>
      </div>
    </section>

    <section class="section gallery" id="gallery">
      <div class="container">
        <div class="gallery-heading"><div><p class="eyebrow">The mountain, in moments</p><h2 class="section-heading">Rinjani, as it is <em>lived.</em></h2></div><p class="section-copy">Summit light, crater water, volcanic slopes, and the long walk home.</p></div>
        <div class="gallery-grid">{gallery.map((item, index) => { const variants = getGalleryImageVariants(item.src); return <figure class={item.shape}><button class="gallery-trigger" type="button" aria-label={`Open image ${index + 1} of ${gallery.length}: ${item.alt}`} data-gallery-index={index}><img src={variants.thumbnail} data-gallery-full={variants.full} data-gallery-width={variants.fullWidth} data-gallery-height={variants.fullHeight} alt={item.alt} loading="lazy" decoding="async" width={variants.width ?? 1600} height={variants.height ?? 1100} /></button></figure>; })}</div>
      </div>
    </section>

    <section class="section trek-needs" aria-labelledby="trek-needs-title">
      <div class="container">
        <header class="trek-needs-header">
          <p class="eyebrow">Thoughtful support on the mountain</p>
          <h2 class="section-heading" id="trek-needs-title">EVERYTHING YOU NEED FOR YOUR TREK</h2>
          <p class="section-copy">Explore the arrangements available for your Rinjani journey. Services depend on the package you select and can be confirmed with our team.</p>
        </header>
        <div class="trek-needs-grid">
          {trekFeatures.map((feature, index) => (
            <article class="trek-feature-card">
              <div class="trek-feature-topline">
                <span class="trek-feature-icon" aria-hidden="true">
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round">
                    {feature.icon === "guide" && <><circle cx="12" cy="10" r="4" /><path d="M4 27v-2a8 8 0 0 1 16 0v2M22 10h6M25 7v6M22 24l3 3 5-6" /></>}
                    {feature.icon === "equipment" && <><path d="M11 9V6a5 5 0 0 1 10 0v3M9 9h14a2 2 0 0 1 2 2v15H7V11a2 2 0 0 1 2-2Z" /><path d="M12 14v3M20 14v3M7 20h18" /></>}
                    {feature.icon === "meals" && <><path d="M5 18h22a9 9 0 0 1-9 9h-4a9 9 0 0 1-9-9Z" /><path d="M8 13c1-2 2-2 3 0s2 2 3 0 2-2 3 0 2 2 3 0 2-2 3 0M10 6v4M16 4v5M22 6v4" /></>}
                    {feature.icon === "water" && <><path d="M16 3S7 14 7 20a9 9 0 0 0 18 0c0-6-9-17-9-17Z" /><path d="M12 21a4 4 0 0 0 4 4" /></>}
                    {feature.icon === "permit" && <><path d="M9 4h10l5 5v19H9a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" /><path d="M19 4v6h5M11 15h9M11 19h6M12 24l2 2 4-5" /></>}
                    {feature.icon === "accommodation" && <><path d="M5 25V9M5 21h22v4M27 25v-9a4 4 0 0 0-4-4H13a4 4 0 0 0-4 4v5" /><path d="M9 17h18M9 15a3 3 0 1 0-6 0v6" /></>}
                    {feature.icon === "transfer" && <><path d="M4 10h16v13H4zM20 15h5l4 5v3h-9z" /><circle cx="9" cy="24" r="2.5" /><circle cx="24" cy="24" r="2.5" /><path d="M8 14h8M23 18h3" /></>}
                    {feature.icon === "luggage" && <><rect x="6" y="10" width="20" height="17" rx="2" /><path d="M12 10V7a4 4 0 0 1 8 0v3M11 14v9M21 14v9M10 27v2M22 27v2" /></>}
                    {feature.icon === "briefing" && <><path d="m4 8 8-4 8 4 8-4v20l-8 4-8-4-8 4V8Z" /><path d="M12 4v20M20 8v20M7 12l2-1M23 16l2-1" /><circle cx="17" cy="14" r="2" /></>}
                  </svg>
                </span>
                <span class="trek-feature-number">{String(index + 1).padStart(2, "0")}</span>
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="lightbox" id="gallery-lightbox" role="dialog" aria-modal="true" aria-label="Image gallery" aria-hidden="true" hidden>
      <button class="lightbox-backdrop" type="button" data-lightbox-close aria-label="Close image viewer"></button>
      <div class="lightbox-panel" role="document">
        <button class="lightbox-control lightbox-close" type="button" data-lightbox-close aria-label="Close image viewer"><span aria-hidden="true">&times;</span></button>
        <button class="lightbox-control lightbox-nav lightbox-prev" type="button" aria-label="Previous image"><span aria-hidden="true">&lsaquo;</span></button>
        <figure class="lightbox-figure">
          <img class="lightbox-image" src="" alt="" />
          <figcaption class="lightbox-caption"><span class="lightbox-alt"></span><span class="lightbox-count" aria-live="polite"></span></figcaption>
        </figure>
        <button class="lightbox-control lightbox-nav lightbox-next" type="button" aria-label="Next image"><span aria-hidden="true">&rsaquo;</span></button>
      </div>
    </div>

    <section class="section contact" id="contact" aria-labelledby="contact-title" style={`--crater-sunset-bg: url("${import.meta.env.BASE_URL}/images/gallery-crater-sunset.jpg")`}>
      <div class="container contact-grid">
        <div class="contact-copy">
          <p class="eyebrow">Your next chapter begins here</p>
          <h2 class="section-heading" id="contact-title">The mountain is<br /><em>calling.</em></h2>
          <p class="section-copy">Tell us what kind of Rinjani journey you have in mind. Share your dates and details, and our local team will help you plan the next step.</p>
          <div class="contact-details" aria-label="Contact information">
            <div><strong>Based in</strong><p>{site.address}</p></div>
            <div><strong>Email</strong><a href={`mailto:${site.email}`}>{site.email}</a></div>
            <div><strong>WhatsApp</strong><a href={whatsappLink()} target="_blank" rel="noopener noreferrer">{site.phone}</a></div>
          </div>
          <a class="text-link" href={whatsappLink()} target="_blank" rel="noopener noreferrer">Speak with our team <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M6 5h9v9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </div>

        <aside class="guest-reviews" aria-labelledby="guest-reviews-title">
          <div class="review-emblem" aria-hidden="true"><span>AR</span><i></i></div>
          <p class="review-kicker">Guest Experiences</p>
          <h3 id="guest-reviews-title">Guest Reviews<br /><em>Coming Soon</em></h3>
          <p class="review-message">We&rsquo;ll share genuine guest stories here once verified. Until then, our local team is happy to answer your questions and help you plan your Rinjani journey.</p>
          <a class="review-contact" href={whatsappLink()} target="_blank" rel="noopener noreferrer">Talk with our local team <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M6 5h9v9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          <p class="review-note">Only authentic guest feedback belongs here.</p>
        </aside>
      </div>
    </section>
  </main>
</Layout>

<script>
  const galleryTriggers = [...document.querySelectorAll<HTMLButtonElement>(".gallery-trigger")];
  const lightbox = document.querySelector<HTMLElement>("#gallery-lightbox");
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>(".lightbox-image");
  const lightboxAlt = lightbox?.querySelector<HTMLElement>(".lightbox-alt");
  const lightboxCount = lightbox?.querySelector<HTMLElement>(".lightbox-count");
  const closeButtons = lightbox?.querySelectorAll<HTMLButtonElement>("[data-lightbox-close]");
  const previousButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-prev");
  const nextButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-next");
  let activeGalleryIndex = 0;
  let lastFocusedElement: HTMLElement | null = null;
  let previousBodyOverflow = "";

  const showGalleryImage = (index: number) => {
    if (!lightbox || !lightboxImage || !lightboxAlt || !lightboxCount || !galleryTriggers.length) return;
    activeGalleryIndex = (index + galleryTriggers.length) % galleryTriggers.length;
    const thumbnail = galleryTriggers[activeGalleryIndex].querySelector("img");
    if (!thumbnail) return;
    lightboxImage.src = thumbnail.dataset.galleryFull || thumbnail.currentSrc || thumbnail.src;
    if (thumbnail.dataset.galleryWidth && thumbnail.dataset.galleryHeight) {
      lightboxImage.width = Number(thumbnail.dataset.galleryWidth);
      lightboxImage.height = Number(thumbnail.dataset.galleryHeight);
    } else {
      lightboxImage.removeAttribute("width");
      lightboxImage.removeAttribute("height");
    }
    lightboxImage.alt = thumbnail.alt;
    lightboxAlt.textContent = thumbnail.alt;
    lightboxCount.textContent = `${activeGalleryIndex + 1} / ${galleryTriggers.length}`;
  };

  const closeLightbox = () => {
    if (!lightbox || lightbox.hidden) return;
    lightbox.classList.remove("is-open");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = previousBodyOverflow;
    window.setTimeout(() => {
      lightbox.hidden = true;
      lastFocusedElement?.focus();
    }, 240);
  };

  galleryTriggers.forEach((trigger, index) => trigger.addEventListener("click", () => {
    if (!lightbox) return;
    lastFocusedElement = trigger;
    previousBodyOverflow = document.body.style.overflow;
    showGalleryImage(index);
    lightbox.hidden = false;
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    window.requestAnimationFrame(() => {
      lightbox.classList.add("is-open");
      lightbox.querySelector<HTMLButtonElement>(".lightbox-close")?.focus();
    });
  }));

  closeButtons?.forEach((button) => button.addEventListener("click", closeLightbox));
  previousButton?.addEventListener("click", () => showGalleryImage(activeGalleryIndex - 1));
  nextButton?.addEventListener("click", () => showGalleryImage(activeGalleryIndex + 1));

  lightbox?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeLightbox();
    if (event.key === "ArrowLeft") showGalleryImage(activeGalleryIndex - 1);
    if (event.key === "ArrowRight") showGalleryImage(activeGalleryIndex + 1);
    if (event.key === "Tab") {
      const focusable = [...lightbox.querySelectorAll<HTMLElement>('button:not([disabled])')];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });

  const heroSlides = [...document.querySelectorAll<HTMLImageElement>(".hero-image")];
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (heroSlides.length > 1 && !reducedMotion.matches) {
    let activeHeroSlide = 0;
    window.setInterval(() => {
      heroSlides[activeHeroSlide].classList.remove("is-active");
      activeHeroSlide = (activeHeroSlide + 1) % heroSlides.length;
      heroSlides[activeHeroSlide].classList.add("is-active");
    }, 3000);
  }

</script>

