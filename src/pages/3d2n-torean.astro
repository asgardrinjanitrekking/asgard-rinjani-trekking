---
import Layout from "../layouts/Layout.astro";
import PackageDetailFrame from "../components/PackageDetailFrame.astro";
import { site, whatsappLink } from "../data/site";

const title = "Mount Rinjani Trekking 3 Days 2 Nights – Sembalun, Summit, Segara Anak Lake & Torean";
const bookingHref = whatsappLink(
  "Hello Asgard Rinjani Trekking, I would like to enquire about the Mount Rinjani Trekking 3 Days 2 Nights – Sembalun, Summit, Segara Anak Lake & Torean. Please share current availability, the confirmed itinerary, difficulty guidance, and package details.",
);

const highlights = [
  "A three-day, two-night journey across Mount Rinjani",
  "A Sembalun start and a Torean Village finish",
  "Time on the mountain shaped around the confirmed park and guide plan",
];

const itinerary = [
  {
    day: "Day 0",
    title: "Arrival in Senaru & Pre-Trek Preparation",
    intro: "Day 0 is for arriving at the trekking office in Senaru and preparing for the Torean trek, which starts in Sembalun the following day. Pickup from a hotel, harbour, or airport to the office is included only when Trek & Transportation is agreed for your booking; Trek Only guests arrange this journey themselves. Both options include the transfer from the office to the Sembalun trailhead on Day 1 and from Torean Village back to the office after the trek. The pickup times and drive estimates below are indicative and must be confirmed with the team. The currently published package information excludes pre-trek accommodation in Senaru unless separately confirmed in writing.",
    pickupSchedule: [
      { location: "Kuta Lombok", time: "09:00 AM or 04:00–05:00 PM" },
      { location: "Senggigi / Mataram", time: "10:00–11:00 AM or 04:00 PM" },
      { location: "Tetebatu / Pringgasela", time: "09:00–10:00 AM" },
      { location: "Bangsal Harbor / Gili Islands", time: "Around 11:30 AM (following your boat arrival)" },
    ],
    recommendation: "If pickup to Senaru is included in your confirmed Trek & Transportation booking, coordinate its timing with the team so you can complete any confirmed preparation and rest before the next morning's transfer to Sembalun.",
    transferTimes: [
      { location: "Lombok International Airport (LOP) / Lembar Harbor", time: "Approximately 3.5 hours" },
      { location: "Mataram / Senggigi", time: "Approximately 2 hours" },
      { location: "Bangsal Harbor", time: "Approximately 1 hour 25 minutes" },
      { location: "Kuta Lombok / Tetebatu", time: "Approximately 4 hours" },
      { location: "Labuan Lombok (Kayangan Harbor)", time: "Approximately 2 hours" },
    ],
    accommodation: "Pre-trek accommodation in Senaru is not included in the currently published package information. Please arrange your own stay unless the team confirms otherwise in writing. Ask the team whether a pre-trek briefing or equipment inspection is scheduled and where it will take place.",
    details: [
    ],
    summary: [],
  },
  {
    day: "Day 1",
    title: "Sembalun Village to Sembalun Crater Rim",
    details: ["TREKKING DETAILS · Trekking Duration: Approximately 6–7 hours  |  Difficulty: Challenging  |  Camping Altitude: Approximately 2,639 m  |  Meals: Lunch and dinner", "07:00 – Meeting at Senaru Office · Meet the Asgard Rinjani Trekking team at the Senaru office. From there, enjoy the included transfer to Sembalun Village. Upon arrival, complete the necessary registration before beginning your trek from the Sembalun trailhead.", "08:00–08:30 – Trek Begins · Begin your journey across Sembalun's beautiful open grasslands and rolling hills. Enjoy the surrounding mountain scenery as you make your way along the trail, with regular breaks along the route.", "12:00 – Lunch at Pos 3 · Take a break at Pos 3 to enjoy lunch and recharge before continuing the ascent. The trail gradually becomes steeper as you approach the Sembalun Crater Rim.", "15:30–16:30 – Arrival at Sembalun Crater Rim · Arrive at the Sembalun Crater Rim, where the team will prepare your campsite. Take time to relax and admire the spectacular views of Segara Anak Lake and Mount Baru Jari. Enjoy dinner at camp while taking in the mountain atmosphere.", "Overnight – First Night at Sembalun Crater Rim · Settle in for your first night of camping at approximately 2,639 metres above sea level, surrounded by the breathtaking scenery of Mount Rinjani."],
  },
  {
    day: "Day 2",
    title: "Sembalun Crater Rim – Rinjani Summit – Segara Anak Lake – Torean Valley",
    details: ["TREKKING DETAILS · Trekking Duration: Approximately 10–12+ hours  |  Difficulty: Very Challenging  |  Highest Point: Rinjani Summit, 3,726 m  |  Meals: Light breakfast before the summit, second breakfast at camp, lunch, and dinner.", "02:00 – Early Morning Breakfast · Wake up early and enjoy a light breakfast and a warm drink before preparing for the summit ascent. Get ready for an early start under the night sky.", "02:30 – Begin the Summit Ascent · Set off by headlamp along the steep volcanic gravel and rocky trail toward the summit of Mount Rinjani. The ascent is demanding, and the schedule and summit attempt depend on weather conditions, trail safety, and national park guidance.", "05:30–06:30 – Reach the Summit of Mount Rinjani · Arrive at the summit of Mount Rinjani at 3,726 metres, where you can enjoy the spectacular sunrise and panoramic mountain views when conditions allow. After spending time at the summit, begin the careful descent toward the crater rim campsite.", "08:00–09:00 – Return to Camp & Second Breakfast · Return to the Sembalun Crater Rim campsite for a second breakfast and a short rest. At approximately 09:30, continue the journey down the steep trail toward Segara Anak Lake, situated at around 2,000 metres above sea level.", "12:30–13:30 – Lunch at Segara Anak Lake · Enjoy lunch beside the beautiful Segara Anak Lake, surrounded by the dramatic volcanic landscape of Mount Rinjani. Depending on the group's progress and trail conditions, there may also be an opportunity to visit the nearby natural hot springs.", "14:00–14:30 – Continue to Torean Valley · After lunch, continue along the Torean route toward the designated valley campsite. The arrival time depends on trail conditions and the group's progress. Dinner will be served at camp.", "Overnight – Second Night in Torean Valley · Spend your second night camping at a designated campsite in the Torean Valley area, surrounded by the natural beauty of Mount Rinjani."],
  },
  {
    day: "Day 3",
    title: "Torean Valley – Torean Village",
    details: ["TREKKING DETAILS · Trekking Duration: Approximately 5–7 hours  |  Difficulty: Moderate to Challenging  |  Finish Point: Torean Village  |  Meals: Breakfast and lunch", "06:30 – Breakfast & Preparation · Enjoy breakfast at the campsite and prepare your belongings for the final day of trekking. At approximately 07:00, begin your descent through the beautiful landscapes of Torean Valley, passing green hillsides, dramatic cliffs, river valleys, and forested trails.", "Around 10:00 – Penimbungan Waterfall Viewpoint · Continue through the scenic Torean Valley, where the Penimbungan Waterfall viewpoint offers one of the memorable highlights of the journey. Take time to admire the surrounding landscape and capture photographs where the guide considers it safe and appropriate.", "Around 12:00 – Lunch & Forest Trail · Take a break at a suitable spot to enjoy lunch and rest before continuing the final stretch through the forest toward Torean Village.", "13:30–15:00 – Arrival at Torean Village · Arrive at Torean Village, marking the end of your trekking adventure. From here, the included transfer will take you back to the Asgard Rinjani Trekking office in Senaru, regardless of your booking option. Guests booking Trek & Transportation can continue with their separately agreed onward drop-off arrangements. Trek Only guests arrange their own onward transportation from the Senaru office.", "End of Trek – Journey Completed · Your three-day Mount Rinjani adventure comes to an end. Take home unforgettable memories of the summit, Segara Anak Lake, and the spectacular Torean Valley."],
  },
];

const gallery = [
  { src: "/asgard-rinjani-trekking/images/trn01.jpg", alt: "Mount Rinjani landscape on the Torean trekking route" },
  { src: "/asgard-rinjani-trekking/images/optimized/hero-trn08.webp", alt: "Mountain terrain along the Torean trekking route" },
  { src: "/asgard-rinjani-trekking/images/trn16.jpg", alt: "Scenic Torean route landscape on Mount Rinjani" },
];

const details = [
  { label: "Duration", value: "3 Days · 2 Nights" },
  { label: "Starting point", value: "Sembalun Village trailhead (via Senaru trekking office)" },
  { label: "Finishing point", value: "Torean Village" },
  { label: "Difficulty", value: "Challenging · very challenging on Day 2" },
  { label: "Maximum elevation", value: "Rinjani Summit · 3,726 m" },
  { label: "Camping location", value: "Sembalun Crater Rim · designated Torean Valley campsite" },
];

const inclusionGroups = [
  {
    title: "Trekking Services",
    items: [
      "Trekking guide and porter support for shared camping equipment, food, and cooking supplies.",
      "Mount Rinjani National Park permits and entrance tickets, as confirmed for your departure.",
      "Transfer from the Senaru trekking office to the Sembalun trekking starting point on Day 1, and from Torean Village back to the Senaru trekking office after the trek. Both transfers are included with Trek Only and Trek & Transportation.",
    ],
  },
  {
    title: "Meals and Drinks",
    items: [
      "Meals listed in the itinerary: Day 1 lunch and dinner; Day 2 light breakfast before the summit, a second breakfast at the Sembalun Crater Rim camp, lunch, and dinner; Day 3 breakfast and lunch. Confirm the meal service and both Day 2 breakfasts with the team.",
      "Drinking water, fresh fruit, tea, and coffee during the trek, subject to the final written package confirmation.",
    ],
  },
  {
    title: "Camping Equipment",
    items: [
      "Mountain camping equipment for two overnight camps, including tents, sleeping bags, mattresses, and pillows; confirm the equipment provided for your departure.",
      "Shared cooking and dining equipment and a portable toilet tent at camp, subject to the final written package confirmation.",
    ],
  },
  {
    title: "Complimentary Trekking Equipment",
    items: [
      "Warm jackets, trekking poles, headlamps, and gloves may be available to borrow at no extra charge, subject to availability. Request items in advance and confirm availability with Asgard Rinjani Trekking.",
    ],
  },
];

const exclusionGroups = [
  {
    title: "Personal Expenses",
    items: [
      "Personal purchases and expenses not listed in the confirmed package inclusions or trek itinerary.",
    ],
  },
  {
    title: "Personal Trekking Equipment",
    items: [
      "Personal clothing, footwear, and trekking equipment. Complimentary equipment loans, if available, are limited to the items and availability confirmed by the team.",
    ],
  },
  {
    title: "Accommodation",
    items: [
      "Accommodation before and after the trekking program, including the pre-trek night in Senaru, is not included in the currently published package information unless separately confirmed in writing. Guests are responsible for arranging their own stay.",
    ],
  },
  {
    title: "Tips and Gratuities",
    items: [
      "Tips or gratuities for guides, porters, drivers, or other service providers are not included and are at the guest’s discretion.",
    ],
  },
  {
    title: "Other Exclusions",
    items: [
      "Travel insurance, personal luggage porter service, and any service or cost not expressly listed in the confirmed package inclusions.",
      "Flights and airfare to and from Lombok are not included in the trekking package.",
    ],
  },
];

const faqs = [
  { question: "How difficult is the 3 Days 2 Nights Torean Trek?", answer: "This trek includes varied mountain terrain, long walking sections and steep descents. Good physical preparation is important. Final difficulty guidance should be confirmed with the trekking guide." },
  { question: "Where does the Torean Trek start and finish?", answer: "The trekking route starts at the Sembalun trailhead and finishes at Torean Village. The itinerary and access remain subject to weather, safety decisions, and Mount Rinjani National Park guidance." },
  { question: "Do I need previous trekking experience?", answer: "Previous trekking experience is helpful. Physical preparation and guidance from an experienced local trekking team are also important." },
  { question: "What should I bring for the trek?", answer: "Suitable trekking clothing, comfortable hiking footwear, personal essentials and the equipment listed in the confirmed packing list." },
  { question: "Are meals and camping equipment included?", answer: "Please refer to the confirmed package inclusions or contact Asgard Rinjani Trekking for the latest details before booking." },
  { question: "Can I book a private Torean Trek?", answer: "Private trekking arrangements may be available depending on the requested dates, group size and operational availability." },
  { question: "What happens if the weather is bad?", answer: "The itinerary may be adjusted depending on weather conditions, mountain safety and applicable national park regulations." },
];
---

<Layout title="Sembalun to Torean Trek | 3 Days, 2 Nights | Asgard" description="Journey from Sembalun to Torean via Mount Rinjani’s summit and Segara Anak Lake. Explore the three-day itinerary and plan your trek with Asgard Rinjani." ogImage="/asgard-rinjani-trekking/images/optimized/package-trn10.webp" ogImageAlt="Dramatic mountain landscape on the Sembalun to Torean route of Mount Rinjani">
  <PackageDetailFrame title={title} heading={"Sembalun to Torean"} route={"Sembalun · Summit · Segara Anak Lake · Torean"} subtitle={"Three days. Two nights. From Sembalun’s open slopes to the Torean Valley."} note={"Estimated itinerary; route and operating conditions are subject to weather, safety, and park guidance."} heroImage={"/asgard-rinjani-trekking/images/optimized/package-trn10.webp"} heroAlt={"Dramatic mountain landscape on the Torean route of Mount Rinjani"} bookingHref={bookingHref} details={details} gallery={gallery} galleryTitle={"The mountain, unfolding."} galleryDescription={"A glimpse of the Rinjani landscapes found across the route."}>

    <section class="section overview" id="overview" aria-labelledby="overview-title">
      <div class="container">
        <div class="section-intro">
          <p class="eyebrow">The journey</p>
          <h2 class="section-heading" id="overview-title">A traverse through <em>Rinjani.</em></h2>
          <p class="section-copy">Meet at the trekking office in Senaru and transfer to the Sembalun trailhead. Trek to the summit, descend to Segara Anak Lake, then follow the Torean Valley to Torean Village, where the trekking route ends.</p>
        </div>
        <dl class="trip-facts">
          {details.map((item) => <div class="fact"><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
        <div class="highlights">
          <div><p class="eyebrow">At a glance</p><h3>Made for the <em>long way through.</em></h3></div>
          <ul>{highlights.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section facilities" aria-labelledby="facilities-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Plan with clarity</p><h2 class="section-heading" id="facilities-title"><em>Inclusions.</em></h2><p class="section-copy">Review the services and equipment associated with the trek. Confirm the final written inclusions for your dates and selected booking option before departure.</p></div>
        <p class="inclusion-note">Both Trek Only and Trek &amp; Transportation include transfers from the trekking office in Senaru to the Sembalun starting point and from Torean Village back to the office. Trek Only excludes pickup from a hotel, harbour, or airport to the office before the trek and drop-off from the office to another destination afterward. Trek &amp; Transportation includes the additional pickup and drop-off arrangements agreed for your booking. Confirm locations and timing with the team.</p>
        <div class="facility-grid">{inclusionGroups.map((group) => <article><span class="facility-mark" aria-hidden="true">✓</span><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
        <div class="section-intro inclusion-subheading"><p class="eyebrow">Plan with clarity</p><h2 class="section-heading"><em>Exclusions.</em></h2><p class="section-copy">The following items are not included unless they are specifically confirmed in writing with your booking.</p></div>
        <div class="facility-grid">{exclusionGroups.map((group) => <article><span class="facility-mark" aria-hidden="true">–</span><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
      </div>
    </section>

<section class="section itinerary" id="itinerary" aria-labelledby="itinerary-title">
      <div class="container">
        <div class="section-intro centered">
          <p class="eyebrow">Three days on the mountain</p>
          <h2 class="section-heading" id="itinerary-title">The route, <em>day by day.</em></h2>
          <p class="section-copy">Times are estimates and can change with weather, trail conditions, group pace, safety decisions, and Mount Rinjani National Park guidance. Confirm final meeting and transfer details with Asgard Rinjani Trekking.</p>
        </div>
        <ol class="day-list">
          {itinerary.map((item) => (
            <li class:list={["day-card", item.day === "Day 0" && "day-card-arrival"]}>
              <span class="day-index">{item.day}</span>
              <div class="day-card-content">
                <h3>{item.title}</h3>
                {item.day === "Day 0" ? (
                  <>
                    <p class="arrival-intro">{item.intro}</p>
                    <div class="arrival-panels">
                      <section class="arrival-panel" aria-labelledby="pickup-schedule-title">
                        <h4 id="pickup-schedule-title"><span class="arrival-icon" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M3 16.5h18M5 16.5V12l2-5h10l2 5v4.5M7 16.5v2m10-2v2M7 12h10M8.5 9h7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7.5" cy="16.5" r="1" fill="currentColor"/><circle cx="16.5" cy="16.5" r="1" fill="currentColor"/></svg></span>Pick-Up Schedule</h4>
                        <ul class="arrival-list">{item.pickupSchedule.map((entry) => <li><strong>{entry.location}</strong><span>{entry.time}</span></li>)}</ul>
                      </section>
                      <section class="arrival-panel" aria-labelledby="transfer-times-title">
                        <h4 id="transfer-times-title"><span class="arrival-icon" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Estimated Transfer Times</h4>
                        <ul class="arrival-list">{item.transferTimes.map((entry) => <li><strong>{entry.location}</strong><span>{entry.time}</span></li>)}</ul>
                      </section>
                    </div>
                    <aside class="arrival-recommendation"><span class="recommendation-label">Our Recommendation</span><p>{item.recommendation}</p></aside>
                    <section class="arrival-accommodation" aria-labelledby="overnight-accommodation-title">
                      <h4 id="overnight-accommodation-title"><span class="arrival-icon" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M3.5 19V8.5L12 4l8.5 4.5V19M2.5 19h19M7 19v-6h10v6M9 10h.01M15 10h.01" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Pre-Trek Accommodation &amp; Briefing</h4>
                      <p>{item.accommodation}</p>
                    </section>
                  </>
                ) : item.details.map((detail) => { const separator = detail.indexOf(" · "); return <p class="itinerary-entry">{separator >= 0 ? <><strong>{detail.slice(0, separator)} ·</strong>{detail.slice(separator + 3)}</> : detail}</p>; })}
              </div>
              <span class="day-mark" aria-hidden="true">→</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    

    

        <section class="section trekking-info" id="trekking-info" aria-labelledby="trekking-info-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Plan with confidence</p><h2 class="section-heading" id="trekking-info-title">Important Information <em>Before Your Trek.</em></h2><p class="section-copy">Routes, schedules, and operating plans can change with mountain conditions and park guidance. Confirm the final meeting point, route, camping plan, packing list, and package arrangements with our team before departure.</p></div>
        <div class="info-grid">
          <article><span class="info-label">What to Bring</span><p>Bring suitable trekking clothing, comfortable hiking footwear, personal essentials, and all items listed in the confirmed packing list. Ask the team for the route-specific list before departure.</p></article>
          <article><span class="info-label">Free Trekking Equipment</span><p>At Asgard Rinjani Trekking, we want every guest to feel comfortable and well-prepared throughout their Mount Rinjani adventure.</p><p>To help make your trekking experience more convenient, we provide complimentary equipment loans for the following items, subject to availability:</p><ul class="equipment-loan-list"><li>Warm trekking jackets.</li><li>Trekking poles.</li><li>Headlamps.</li><li>Gloves.</li><li>All other equipment listed in the Inclusions section.</li></ul><p>Guests who require any of these items are encouraged to inform our team in advance so we can check availability and prepare the equipment before departure.</p><p>Please note that these items are provided as complimentary loans and must be returned to our team after the trekking program.</p><p>We recommend bringing your own personal trekking shoes, comfortable hiking clothes, and other essential personal equipment.</p></article>
          <article><span class="info-label">Additional Information</span><p>All trekking schedules are estimated and may vary depending on weather conditions, individual fitness levels, trail conditions, and regulations from Mount Rinjani National Park authorities.</p><p>This three-day trekking adventure is physically demanding, particularly on Day 2, which includes the summit ascent and descent to Segara Anak Lake. We recommend this trek for participants with good physical fitness and previous hiking experience.</p><p>Please note that the Torean route is subject to official access approval and current conditions from Mount Rinjani National Park authorities. If the route is closed or restricted, alternative arrangements or routes may be necessary.</p></article>
          <article><span class="info-label">Why Choose Asgard Rinjani Trekking?</span><p>Plan your Mount Rinjani journey with a local Lombok trekking team. Contact us for route-specific preparation guidance and to confirm the arrangements for your dates.</p></article>
        </div>
      </div>
    </section><section class="section faq" aria-labelledby="faq-title">
      <div class="container faq-container">
        <header class="faq-heading">
          <p class="eyebrow">Frequently Asked Questions</p>
          <h2 class="section-heading" id="faq-title">Everything You Need to <em>Know.</em></h2>
          <p class="section-copy">A few helpful details as you prepare for the Torean Traverse.</p>
        </header>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <article class="faq-item">
              <h3>
                <button class="faq-trigger" type="button" id={`faq-trigger-${index}`} aria-expanded="false" aria-controls={`faq-panel-${index}`}>
                  <span>{faq.question}</span><span class="faq-icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="faq-panel" id={`faq-panel-${index}`} role="region" aria-labelledby={`faq-trigger-${index}`} aria-hidden="true" inert>
                <div class="faq-panel-inner"><p>{faq.answer}</p></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="route-showcase" aria-labelledby="route-showcase-title">
      <div class="container route-showcase-container">
        <header class="route-showcase-heading">
          <p class="eyebrow">EXPLORE MOUNT RINJANI</p>
          <h2 class="section-heading" id="route-showcase-title">Explore Your Rinjani Route</h2>
          <p class="section-copy">Discover the spectacular trekking route from Sembalun to the summit of Mount Rinjani, Segara Anak Lake, and down to Torean.</p>
        </header>
        <figure class="route-showcase-map">
          <img src="/asgard-rinjani-trekking/images/asgard-rinjani-3d2n-map.png.jpg" alt="Asgard Rinjani 3 Days 2 Nights Sembalun to Torean trekking route map" loading="lazy" decoding="async" />
        </figure>
        <p class="route-showcase-caption">SEMBOLUN – SUMMIT – SEGARA ANAK – TOREAN</p>
        <p class="route-showcase-support">One extraordinary journey across the diverse landscapes of Mount Rinjani, from Sembalun to Torean.</p>
      </div>
    </section>
  </PackageDetailFrame>
</Layout>

<style>
  .hero{position:relative;min-height:min(850px,100svh);min-height:max(690px,92svh);display:flex;align-items:center;overflow:hidden;background:#080908;padding:calc(var(--header-h) + 72px) 0 100px}
  .hero-image,.hero-shade{position:absolute;inset:0;width:100%;height:100%}.hero-image{object-fit:cover;object-position:center 48%;animation:reveal 1.5s ease both}.hero-shade{background:linear-gradient(90deg,rgba(5,6,5,.85),rgba(5,6,5,.45) 58%,rgba(5,6,5,.08)),linear-gradient(0deg,#080908 0%,transparent 45%,rgba(4,5,4,.2))}
  .hero-content{position:relative;z-index:1;max-width:1180px;animation:rise .9s .12s both}.hero h1{font:500 clamp(4.4rem,10vw,9rem)/.88 var(--font-display);letter-spacing:-.045em;color:#fff;margin:0 0 25px}.hero h1 em,.section-heading em,.highlights h3 em{color:var(--gold-soft);font-weight:500}.hero-subtitle{max-width:590px;color:#eee7d9;font:400 clamp(1.25rem,2.4vw,1.7rem)/1.45 var(--font-display);margin:0 0 10px}.hero-note{font-size:.82rem;color:#c0baae;margin:0 0 27px}.actions{display:flex;gap:13px;flex-wrap:wrap}.actions .btn{min-height:54px}.scroll-cue{position:absolute;z-index:1;bottom:32px;left:max(5vw,calc((100vw - 1180px)/2));display:flex;gap:12px;align-items:center;color:#e6dfd1;text-decoration:none;text-transform:uppercase;font-size:.63rem;letter-spacing:.2em}.scroll-cue span{width:1px;height:34px;background:var(--gold)}
  .section{padding:64px 0}.overview{background:#0b0c0b}.section-intro{max-width:700px;margin-bottom:30px}.section-heading{font-size:clamp(2.8rem,5vw,4.8rem);margin-bottom:18px}.trip-facts{display:grid;grid-template-columns:repeat(4,1fr);margin:0;border-block:1px solid var(--line)}.fact{padding:23px 20px 25px 0}.fact dt{font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:8px}.fact dd{margin:0;color:var(--cream);font:500 1.35rem/1.25 var(--font-display)}
