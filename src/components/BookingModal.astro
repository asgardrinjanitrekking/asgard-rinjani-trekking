---
import { site } from "../data/site";

const packages = [
  { id: "torean", title: "Mount Rinjani Trekking 3 Days 2 Nights – Sembalun, Summit, Segara Anak Lake & Torean", duration: "3 Days 2 Nights", route: "Sembalun · Summit · Segara Anak · Torean", image: "/asgard-rinjani-trekking/images/optimized/package-trn10.webp" },
  { id: "senaru-crater-rim", title: "Mount Rinjani Senaru Crater Rim Trekking 2 Days 1 Night", duration: "2 Days 1 Night", route: "Senaru Crater Rim", image: "/asgard-rinjani-trekking/images/optimized/package-senaru09.webp" },
  { id: "second-summit", title: "Mount Rinjani Second Summit Trekking 2 Days 1 Night", duration: "2 Days 1 Night", route: "Second Summit Route", image: "/asgard-rinjani-trekking/images/optimized/package-ss03.webp" },
  { id: "summit", title: "Mount Rinjani Summit Trekking 2 Days 1 Night", duration: "2 Days 1 Night", route: "Sembalun to Summit", image: "/asgard-rinjani-trekking/images/optimized/package-summit12.webp" },
  { id: "sembalun-senaru", title: "Mount Rinjani Trekking 3 Days 2 Nights – Sembalun to Senaru", duration: "3 Days 2 Nights", route: "Sembalun · Summit · Senaru", image: "/asgard-rinjani-trekking/images/optimized/package-smbln05.webp" },
  { id: "4d3n-rinjani", title: "Mount Rinjani Trekking 4 Days 3 Nights", duration: "4 Days 3 Nights", route: "Extended Mount Rinjani", image: "/asgard-rinjani-trekking/images/optimized/package-trn03.webp" },
];
---

<div class="booking-modal" id="booking-modal" aria-hidden="true" data-whatsapp={site.whatsapp} hidden>
  <button class="booking-backdrop" type="button" data-booking-close aria-label="Close booking window"></button>
  <section class="booking-dialog" role="dialog" aria-modal="true" aria-labelledby="booking-title" tabindex="-1">
    <header class="booking-modal-header">
      <div>
        <p class="booking-eyebrow">Asgard Rinjani Trekking</p>
        <h2 id="booking-title">Plan your Rinjani journey</h2>
      </div>
      <button class="booking-close" type="button" data-booking-close aria-label="Close booking window"><span aria-hidden="true">×</span></button>
    </header>

    <ol class="booking-progress" aria-label="Booking progress">
      <li class="is-current" data-booking-progress="1" aria-current="step"><span>01</span> Package</li>
      <li data-booking-progress="2"><span>02</span> Traveler Info</li>
      <li data-booking-progress="3"><span>03</span> Payment</li>
    </ol>

    <form class="booking-modal-form" id="booking-modal-form" novalidate>
      <div class="booking-modal-main">
        <section class="booking-panel" data-booking-panel="1" aria-labelledby="booking-trip-heading">
          <p class="booking-panel-kicker">Step 1 · Package</p>
          <h3 id="booking-trip-heading" tabindex="-1">Choose your departure</h3>
          <div class="booking-field-grid">
            <label class="booking-field booking-field-wide" for="booking-package">Trekking package
              <select id="booking-package" name="package" required>
                <option value="" disabled>Select a trekking package</option>
                {packages.map((item) => <option value={item.id} data-title={item.title} data-duration={item.duration} data-route={item.route} data-image={item.image}>{item.title}</option>)}
              </select>
            </label>
            <label class="booking-field" for="booking-date">Departure date
              <input id="booking-date" name="date" type="date" required />
            </label>
            <label class="booking-field" for="booking-travelers">Participants
              <input id="booking-travelers" name="participants" type="number" min="1" max="30" step="1" value="1" inputmode="numeric" required />
            </label>
          </div>
          <fieldset class="booking-options">
            <legend>Booking option</legend>
            <label><input type="radio" name="bookingOption" value="Trek Only" checked required /><span><strong>Trek Only</strong><small>Includes trekking transfers between the Senaru office and the trek starting and ending points. Pickup and drop-off from other locations in Lombok are not included.</small></span></label>
            <label class="booking-option-transport"><input type="radio" name="bookingOption" value="Trek + Transportation" /><span><em class="recommended-choice">A Recommended Choice</em><strong>Trek + Transportation</strong><small>Includes trekking transfers, plus pickup from your accommodation or chosen location in Lombok to our Senaru office and return drop-off after the trek.</small></span></label>
          </fieldset>
        </section>

        <section class="booking-panel" data-booking-panel="2" aria-labelledby="booking-traveler-heading" hidden>
          <p class="booking-panel-kicker">Step 2 · Traveler Info</p>
          <h3 id="booking-traveler-heading" tabindex="-1">Who is traveling?</h3>
          <div class="booking-field-grid">
            <label class="booking-field booking-field-wide" for="booking-name">Full name
              <input id="booking-name" name="fullName" type="text" autocomplete="name" required placeholder="Your full name" />
            </label>
            <label class="booking-field booking-field-wide" for="booking-email">Email address
              <input id="booking-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
            </label>
            <label class="booking-field booking-field-wide" for="booking-country">Country
              <input id="booking-country" name="country" type="text" autocomplete="country-name" required placeholder="Your country" />
            </label>
          </div>
        </section>

        <section class="booking-panel" data-booking-panel="3" aria-labelledby="booking-payment-heading" hidden>
          <p class="booking-panel-kicker">Step 3 · Payment</p>
          <h3 id="booking-payment-heading" tabindex="-1">Review your request</h3>
          <p class="booking-payment-note">No payment is collected in this booking interface. Package pricing, availability, and payment details will be confirmed by the Asgard team before you make a reservation.</p>
          <p class="booking-payment-contact">Your WhatsApp app will open with these details for you to review and send.</p>
        </section>

        <div class="booking-form-actions">
          <button class="booking-back" type="button" data-booking-previous hidden>Back</button>
          <button class="booking-next" type="button" data-booking-next>Continue to traveler info <span aria-hidden="true">→</span></button>
          <button class="booking-submit" type="submit" hidden>Send enquiry on WhatsApp <span aria-hidden="true">↗</span></button>
        </div>
      </div>

      <aside class="booking-summary" aria-labelledby="booking-summary-heading">
        <p class="booking-summary-kicker">Your selection</p>
        <img class="booking-summary-image" src="/asgard-rinjani-trekking/images/optimized/package-trn10.webp" alt="" loading="lazy" decoding="async" />
        <h3 id="booking-summary-heading" data-summary-title>Select a trekking package</h3>
        <p class="booking-summary-route" data-summary-route></p>
        <dl>
          <div><dt>Duration</dt><dd data-summary-duration>—</dd></div>
          <div><dt>Departure</dt><dd data-summary-date>Choose a date</dd></div>
          <div><dt>Travelers</dt><dd data-summary-travelers>1 participant</dd></div>
          <div><dt>Option</dt><dd data-summary-option>Trek Only</dd></div>
        </dl>
        <div class="booking-total"><span>Trip total</span><strong data-summary-total>Contact for pricing</strong></div>
        <p class="booking-summary-note">No unconfirmed prices or availability are shown.</p>
      </aside>
    </form>
  </section>
</div>

<style>
  .booking-modal[hidden]{display:none}
  .booking-modal{position:fixed;z-index:3000;inset:0;display:grid;place-items:center;padding:clamp(12px,3vw,40px);opacity:0;transition:opacity .22s ease}
  .booking-modal.is-open{opacity:1}
  .booking-backdrop{position:absolute;inset:0;width:100%;height:100%;border:0;background:rgba(2,5,3,.82);backdrop-filter:blur(8px);cursor:default}
  .booking-dialog{position:relative;z-index:1;width:min(100%,1060px);max-height:min(92vh,900px);overflow:auto;border:1px solid rgba(212,175,55,.42);background:linear-gradient(150deg,#101a13,#080b09 72%);box-shadow:0 32px 100px rgba(0,0,0,.68);transform:translateY(12px) scale(.99);transition:transform .22s ease;color:#f2eee4}
  .booking-modal.is-open .booking-dialog{transform:none}
  .booking-modal-header{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:26px 30px 21px;border-bottom:1px solid rgba(212,175,55,.17)}
  .booking-eyebrow,.booking-panel-kicker,.booking-summary-kicker{margin:0 0 8px;color:#d4af37;font-size:.62rem;font-weight:600;letter-spacing:.19em;text-transform:uppercase}
  .booking-modal-header h2{margin:0;color:#f4efdf;font:500 clamp(1.8rem,3vw,2.45rem)/1.05 var(--font-display)}
  .booking-close{display:grid;flex:none;place-items:center;width:44px;height:44px;border:1px solid rgba(212,175,55,.35);background:rgba(255,255,255,.025);color:#f1dc98;font:300 1.8rem/1 var(--font-display);cursor:pointer;transition:background .2s,color .2s}
  .booking-close:hover{background:#d4af37;color:#090b09}
  .booking-progress{display:grid;grid-template-columns:repeat(3,1fr);margin:0;padding:0 30px;border-bottom:1px solid rgba(255,255,255,.08);list-style:none}
  .booking-progress li{display:flex;align-items:center;gap:10px;min-height:56px;border-bottom:2px solid transparent;color:#7f887d;font-size:.64rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase}
  .booking-progress li span{color:#788075;font-variant-numeric:tabular-nums}
  .booking-progress li.is-current{border-color:#d4af37;color:#f2e8cb}
  .booking-progress li.is-current span,.booking-progress li.is-complete span{color:#e6c76a}
  .booking-modal-form{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.8fr);gap:0}
  .booking-modal-main{min-width:0;padding:28px 30px 30px}
  .booking-panel h3{margin:0 0 22px;color:#f5f0e5;font:500 1.75rem/1.1 var(--font-display)}
  .booking-field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
  .booking-field{display:grid;min-width:0;gap:7px;color:#c6c4b9;font-size:.68rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase}
  .booking-field-wide{grid-column:1/-1}
  .booking-field input,.booking-field select{width:100%;min-width:0;min-height:46px;padding:11px 12px;border:1px solid rgba(255,255,255,.15);border-radius:2px;background:#0b100d;color:#f3efe5;font:400 .85rem/1.4 var(--font-body);letter-spacing:normal;text-transform:none}
  .booking-field input:focus-visible,.booking-field select:focus-visible{outline:2px solid #d4af37;outline-offset:2px;border-color:#d4af37}
  .booking-field select option{background:#0b100d;color:#f3efe5}
  .booking-options{display:grid;gap:9px;margin:21px 0 0;padding:0;border:0}
  .booking-options legend{margin-bottom:9px;color:#c6c4b9;font-size:.68rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase}
  .booking-options label{display:flex;align-items:flex-start;gap:11px;padding:13px;border:1px solid rgba(212,175,55,.17);background:rgba(255,255,255,.018);cursor:pointer}
  .booking-options label:has(input:checked){border-color:rgba(212,175,55,.58);background:rgba(212,175,55,.055)}
  .booking-options input{flex:none;margin:3px 0 0;accent-color:#d4af37}
  .booking-options label span{display:grid;gap:4px;min-width:0}
  .booking-option-transport{position:relative}
  .booking-option-transport .recommended-choice{position:absolute;top:12px;right:12px;margin:0;color:#D8C18B;font-size:12px;font-style:italic;font-weight:400;letter-spacing:normal;line-height:1.35;text-transform:none;white-space:nowrap}
  .booking-options strong{color:#eee8d8;font-size:.78rem;font-weight:500;line-height:1.4}
  .booking-options small{color:#9fa79b;font-size:.69rem;line-height:1.5}
  .booking-payment-note,.booking-payment-contact{max-width:560px;color:#b4b9ad;font-size:.9rem;line-height:1.7}
  .booking-payment-contact{padding:14px 16px;border-left:2px solid #d4af37;background:rgba(212,175,55,.045);color:#d9d4c6}
  .booking-form-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:25px}
  .booking-form-actions button{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:0 18px;border:1px solid rgba(212,175,55,.43);background:transparent;color:#f0e9d6;font:600 .64rem/1.2 var(--font-body);letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:filter .2s,background .2s,border-color .2s}
  .booking-form-actions button:hover{border-color:#e6c76a;background:rgba(212,175,55,.08)}
  .booking-form-actions .booking-next,.booking-form-actions .booking-submit{margin-left:auto;border-color:transparent;background:linear-gradient(135deg,#d4af37,#a67c32);color:#10120e}
  .booking-form-actions .booking-submit{background:linear-gradient(135deg,#16823b,#0d642c);color:#fff}
  .booking-form-actions button:focus-visible,.booking-close:focus-visible{outline:2px solid #f3ead6;outline-offset:3px}
  .booking-form-actions [hidden],.booking-panel[hidden]{display:none}
  .booking-summary{min-width:0;padding:27px 24px;background:rgba(0,0,0,.26);border-left:1px solid rgba(255,255,255,.08)}
  .booking-summary-image{display:block;width:100%;height:150px;margin:15px 0;object-fit:cover;border:1px solid rgba(212,175,55,.2);filter:saturate(.8)}
  .booking-summary h3{margin:0;color:#f4efdf;font:500 1.45rem/1.15 var(--font-display);overflow-wrap:anywhere}
  .booking-summary-route{margin:7px 0 15px;color:#b0b8ad;font-size:.72rem;line-height:1.5}
  .booking-summary dl{margin:0}
  .booking-summary dl>div{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.08)}
  .booking-summary dt{color:#929b90;font-size:.61rem;letter-spacing:.1em;text-transform:uppercase}
  .booking-summary dd{max-width:65%;margin:0;color:#e8e3d7;font-size:.73rem;text-align:right;overflow-wrap:anywhere}
  .booking-total{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-top:18px;padding-top:15px;border-top:1px solid rgba(212,175,55,.34)}
  .booking-total span{color:#c7c4b9;font-size:.68rem;letter-spacing:.07em;text-transform:uppercase}
  .booking-total strong{color:#e6c76a;font:500 1.08rem/1.2 var(--font-display);text-align:right}
  .booking-summary-note{margin:12px 0 0;color:#858d83;font-size:.65rem;line-height:1.5}
  .booking-modal :focus-visible{outline-color:#e6c76a}
  @media(max-width:760px){.booking-modal{padding:10px}.booking-dialog{max-height:calc(100dvh - 20px)}.booking-modal-header{padding:20px 20px 17px}.booking-progress{padding-inline:20px}.booking-modal-form{grid-template-columns:1fr}.booking-modal-main{padding:22px 20px}.booking-summary{order:-1;padding:18px 20px;border:0;border-bottom:1px solid rgba(255,255,255,.08)}.booking-summary-image{float:left;width:90px;height:72px;margin:0 14px 10px 0}.booking-summary h3{font-size:1.18rem}.booking-summary-route{margin:5px 0 10px}.booking-summary dl{clear:both;display:grid;grid-template-columns:1fr 1fr;column-gap:16px}.booking-summary dl>div{display:block}.booking-summary dd{max-width:none;margin-top:4px;text-align:left}.booking-total{margin-top:12px}.booking-summary-note{display:none}}
  @media(max-width:460px){.booking-modal{padding:0}.booking-dialog{width:100%;max-height:100dvh;height:100dvh;border:0}.booking-modal-header{padding:17px 16px 14px}.booking-modal-header h2{font-size:1.65rem}.booking-progress{padding-inline:16px}.booking-progress li{gap:6px;font-size:.55rem}.booking-progress li span{font-size:.58rem}.booking-modal-main{padding:19px 16px 24px}.booking-panel h3{margin-bottom:18px;font-size:1.55rem}.booking-field-grid{grid-template-columns:1fr;gap:12px}.booking-field-wide{grid-column:auto}.booking-options{margin-top:17px}.booking-options label{padding:11px}.booking-option-transport>span>strong{max-width:calc(100% - 126px)}.booking-form-actions button{min-height:46px;padding-inline:13px;font-size:.58rem}.booking-summary{padding:14px 16px}.booking-summary-image{width:70px;height:60px;margin-right:11px}.booking-summary h3{font-size:1.02rem}.booking-summary dl>div{padding:7px 0}.booking-total{margin-top:8px;padding-top:10px}}
  @media(prefers-reduced-motion:reduce){.booking-modal,.booking-dialog,.booking-close,.booking-form-actions button{transition:none}}
</style>

<script>
  const bookingModal = document.querySelector<HTMLElement>("#booking-modal");
  const bookingDialog = bookingModal?.querySelector<HTMLElement>(".booking-dialog");
  const bookingForm = bookingModal?.querySelector<HTMLFormElement>("#booking-modal-form");
  const packageSelect = bookingModal?.querySelector<HTMLSelectElement>("#booking-package");
  const bookingDate = bookingModal?.querySelector<HTMLInputElement>("#booking-date");
  const bookingProgress = [...(bookingModal?.querySelectorAll<HTMLElement>("[data-booking-progress]") ?? [])];
  const bookingPanels = [...(bookingModal?.querySelectorAll<HTMLElement>("[data-booking-panel]") ?? [])];
  const summaryTitle = bookingModal?.querySelector<HTMLElement>("[data-summary-title]");
  const summaryRoute = bookingModal?.querySelector<HTMLElement>("[data-summary-route]");
  const summaryDuration = bookingModal?.querySelector<HTMLElement>("[data-summary-duration]");
  const summaryDate = bookingModal?.querySelector<HTMLElement>("[data-summary-date]");
  const summaryTravelers = bookingModal?.querySelector<HTMLElement>("[data-summary-travelers]");
  const summaryOption = bookingModal?.querySelector<HTMLElement>("[data-summary-option]");
  const summaryImage = bookingModal?.querySelector<HTMLImageElement>(".booking-summary-image");
  const previousButton = bookingModal?.querySelector<HTMLButtonElement>("[data-booking-previous]");
  const nextButton = bookingModal?.querySelector<HTMLButtonElement>("[data-booking-next]");
  const submitButton = bookingModal?.querySelector<HTMLButtonElement>(".booking-submit");
  let bookingStep = 1;
  let lastBookingTrigger: HTMLElement | null = null;
  let priorBodyOverflow = "";

  const selectedPackage = () => packageSelect?.selectedOptions[0];

  const updateBookingSummary = () => {
    const selected = selectedPackage();
    if (!selected || !selected.value) return;
    const title = selected.dataset.title ?? selected.textContent?.trim() ?? "Mount Rinjani Trekking";
    const travelers = Number(bookingForm?.elements.namedItem("participants") instanceof HTMLInputElement ? (bookingForm.elements.namedItem("participants") as HTMLInputElement).value : 1) || 1;
    const dateValue = bookingDate?.value;
    const optionValue = bookingForm?.querySelector<HTMLInputElement>('input[name="bookingOption"]:checked')?.value ?? "Trek Only";
    if (summaryTitle) summaryTitle.textContent = title;
    if (summaryRoute) summaryRoute.textContent = selected.dataset.route ?? "";
    if (summaryDuration) summaryDuration.textContent = selected.dataset.duration ?? "To be confirmed";
    if (summaryDate) summaryDate.textContent = dateValue ? new Date(`${dateValue}T00:00:00`).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" }) : "Choose a date";
    if (summaryTravelers) summaryTravelers.textContent = `${travelers} ${travelers === 1 ? "participant" : "participants"}`;
    if (summaryOption) summaryOption.textContent = optionValue;
    if (summaryImage) {
      summaryImage.src = selected.dataset.image ?? "";
      summaryImage.alt = `${title} landscape`;
    }
  };

  const setBookingStep = (step: number) => {
    bookingStep = Math.min(3, Math.max(1, step));
    bookingPanels.forEach((panel) => { panel.hidden = Number(panel.dataset.bookingPanel) !== bookingStep; });
    bookingProgress.forEach((item) => {
      const itemStep = Number(item.dataset.bookingProgress);
      item.classList.toggle("is-current", itemStep === bookingStep);
      item.classList.toggle("is-complete", itemStep < bookingStep);
      if (itemStep === bookingStep) item.setAttribute("aria-current", "step");
      else item.removeAttribute("aria-current");
    });
    if (previousButton) previousButton.hidden = bookingStep === 1;
    if (nextButton) nextButton.hidden = bookingStep === 3;
    if (submitButton) submitButton.hidden = bookingStep !== 3;
  };

  const openBookingModal = (trigger: HTMLElement) => {
    if (!bookingModal || !bookingDialog || !packageSelect) return;
    lastBookingTrigger = trigger;
    const packageId = trigger.dataset.bookingPackage;
    if (packageId && [...packageSelect.options].some((option) => option.value === packageId)) packageSelect.value = packageId;
    if (bookingForm) {
      bookingForm.reset();
      if (packageId && [...packageSelect.options].some((option) => option.value === packageId)) packageSelect.value = packageId;
    }
    if (bookingDate) {
      const now = new Date();
      const localToday = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
      bookingDate.min = localToday;
    }
    setBookingStep(1);
    updateBookingSummary();
    priorBodyOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    bookingModal.hidden = false;
    bookingModal.setAttribute("aria-hidden", "false");
    requestAnimationFrame(() => {
      bookingModal.classList.add("is-open");
      bookingModal.querySelector<HTMLButtonElement>(".booking-close")?.focus();
    });
  };

  const closeBookingModal = () => {
    if (!bookingModal || bookingModal.hidden) return;
    bookingModal.classList.remove("is-open");
    bookingModal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = priorBodyOverflow;
    window.setTimeout(() => { if (bookingModal) bookingModal.hidden = true; }, 230);
    lastBookingTrigger?.focus();
  };

  document.querySelectorAll<HTMLElement>("[data-booking-open]").forEach((trigger) => {
    trigger.addEventListener("click", () => openBookingModal(trigger));
  });
  bookingModal?.querySelectorAll<HTMLButtonElement>("[data-booking-close]").forEach((button) => button.addEventListener("click", closeBookingModal));
  packageSelect?.addEventListener("change", updateBookingSummary);
  bookingForm?.addEventListener("input", updateBookingSummary);
  bookingForm?.addEventListener("change", updateBookingSummary);
  previousButton?.addEventListener("click", () => setBookingStep(bookingStep - 1));
  nextButton?.addEventListener("click", () => {
    const currentPanel = bookingModal?.querySelector<HTMLElement>(`[data-booking-panel="${bookingStep}"]`);
    const invalidField = currentPanel?.querySelector<HTMLElement>(":invalid");
    if (invalidField) {
      if (invalidField instanceof HTMLElement) invalidField.focus();
      if (invalidField instanceof HTMLInputElement || invalidField instanceof HTMLSelectElement) invalidField.reportValidity();
      return;
    }
    setBookingStep(bookingStep + 1);
    bookingModal?.querySelector<HTMLElement>(`[data-booking-panel="${bookingStep}"] h3`)?.focus();
    updateBookingSummary();
  });

  bookingForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const fullName = bookingForm.elements.namedItem("fullName") instanceof HTMLInputElement ? bookingForm.elements.namedItem("fullName").value.trim() : "";
    const email = bookingForm.elements.namedItem("email") instanceof HTMLInputElement ? bookingForm.elements.namedItem("email").value.trim() : "";
    const country = bookingForm.elements.namedItem("country") instanceof HTMLInputElement ? bookingForm.elements.namedItem("country").value.trim() : "";
    const packageTitle = selectedPackage()?.dataset.title ?? "Mount Rinjani Trekking";
    const date = bookingDate?.value ?? "";
    const participants = bookingForm.elements.namedItem("participants") instanceof HTMLInputElement ? bookingForm.elements.namedItem("participants").value : "1";
    const option = bookingForm.querySelector<HTMLInputElement>('input[name="bookingOption"]:checked')?.value ?? "Trek Only";
    const message = [
      "Hello Asgard Rinjani Trekking!",
      "I would like to request booking details.",
      "",
      `Trekking Package: ${packageTitle}`,
      `Booking Option: ${option}`,
      `Departure Date: ${date}`,
      `Participants: ${participants}`,
      `Full Name: ${fullName}`,
      `Email: ${email}`,
      `Country: ${country}`,
      "Trip Total: Please confirm current pricing.",
      "",
      "Please confirm availability and the current package details. Thank you!",
    ].join("\n");
    const number = bookingModal?.dataset.whatsapp;
    if (number) window.open(`https://wa.me/${number}?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
    closeBookingModal();
  });

  bookingModal?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") { event.preventDefault(); closeBookingModal(); }
    if (event.key === "Tab" && bookingDialog) {
      const focusable = [...bookingDialog.querySelectorAll<HTMLElement>('button:not([disabled]):not([hidden]), input:not([disabled]), select:not([disabled])')].filter((element) => element.offsetParent !== null);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });
</script>
