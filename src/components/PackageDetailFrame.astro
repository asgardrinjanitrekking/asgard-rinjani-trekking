  .price-option-heading-blue{background:#193b59}
  .price-option-body{padding:12px 13px 13px}
  .price-value{display:flex;justify-content:space-between;align-items:baseline;gap:9px;margin:0 0 5px}
  .price-value strong{color:var(--gold-soft);font:500 1.12rem/1.2 var(--font-display)}
