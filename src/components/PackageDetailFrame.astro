  .booking-card-button:focus-visible,.package-intro-actions a:focus-visible{outline:2px solid #f3ead6;outline-offset:3px}
  .booking-card-note{margin:13px 0 0;color:#959d91;font-size:.68rem;line-height:1.55}
  .package-sections{min-width:0}
  .mobile-booking-bar{display:none}
  .package-sections :global(.section){padding:46px 0;border-bottom:1px solid rgba(212,175,55,.13)}
  .package-sections :global(.overview){position:relative;isolation:isolate;background:#050505}
  .package-sections :global(.overview)::before{position:absolute;z-index:-1;inset-block:0;left:50%;width:100vw;transform:translateX(-50%);background:#050505;content:"";pointer-events:none}
  .package-sections :global(.container){width:100%;max-width:none;margin-inline:0}
  .package-sections :global(.section-intro){margin-bottom:26px}
  .package-sections :global(.section-heading){font-size:clamp(2.2rem,3.7vw,3.65rem)}
  .package-sections :global(.section-copy){font-size:.94rem;line-height:1.75}
  .package-sections :global(.facilities){background:linear-gradient(145deg,rgba(19,43,30,.42),rgba(8,13,10,.38))}
  .package-sections :global(.inclusion-note){margin:-12px 0 24px;padding:14px 16px;border-left:2px solid var(--gold);background:rgba(212,175,55,.045);color:#b9c0b5;font-size:.79rem;line-height:1.65}
  .package-sections :global(.trekking-info){background:linear-gradient(145deg,rgba(17,39,27,.4),rgba(7,12,9,.35))}
  .package-sections :global(.info-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}
  .package-sections :global(.info-grid article){min-width:0;padding:20px 18px;border:1px solid rgba(212,175,55,.18);background:linear-gradient(145deg,rgba(255,255,255,.035),rgba(255,255,255,.008))}
  .package-sections :global(.info-label){display:block;margin-bottom:10px;color:var(--gold-soft);font:500 1.2rem/1.15 var(--font-display)}
  .package-sections :global(.info-grid article p){margin:0;color:#aeb6aa;font-size:.78rem;line-height:1.65}
  .package-sections :global(.equipment-loan-list li){font-size:.76rem;font-weight:500;line-height:1.65;color:#aeb6aa}
  .package-sections :global(.booking){margin-top:32px;padding:42px 24px;border:1px solid rgba(212,175,55,.25);border-radius:4px}
  @media(max-width:980px){.package-layout{width:min(900px,calc(100% - 8vw));gap:28px}.package-intro,.package-sections{width:100%}.booking-card{padding:24px}.booking-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:20px}.booking-card h2{max-width:680px}.package-sections :global(.section){padding:44px 0}.package-sections :global(.info-grid){grid-template-columns:repeat(2,minmax(0,1fr))}}
