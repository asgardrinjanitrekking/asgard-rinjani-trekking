3vw,16px);background:linear-gradient(135deg,#16823b,#0d642c);color:#fff;font-size:clamp(.56rem,2.5vw,.66rem);font-weight:700;letter-spacing:.035em;text-decoration:none;text-transform:uppercase;white-space:nowrap}.mobile-booking-bar>a:focus-visible{outline:2px solid #f3ead6;outline-offset:3px}:global(body:has(.package-page) .wa-float){bottom:calc(88px + env(safe-area-inset-bottom))}}
  @media(max-width:420px){.booking-facts{grid-template-columns:1fr}.package-photo-frame{aspect-ratio:1.05}.gallery-thumbnails{grid-template-columns:repeat(4,minmax(0,1fr))}.package-sections :global(.gallery-grid){grid-template-columns:1fr}}
  @media(max-width:380px){.mobile-booking-bar{gap:8px;padding:8px 10px}.mobile-booking-bar p strong{font-size:.8rem}.mobile-booking-bar>a{min-height:44px;padding-inline:9px;font-size:.54rem}}
  @media(max-width:700px){.mobile-booking-bar>button{display:flex;flex:none;align-items:center;justify-content:center;gap:7px;min-height:44px;padding:0 clamp(10px,3vw,16px);border:0;background:linear-gradient(135deg,#16823b,#0d642c);color:#fff;font:700 clamp(.56rem,2.5vw,.66rem)/1.2 var(--font-body);letter-spacing:.035em;text-align:center;text-transform:uppercase;white-space:nowrap;cursor:pointer}.mobile-booking-bar>button:focus-visible{outline:2px solid #f3ead6;outline-offset:3px}}
  @media(max-width:380px){.mobile-booking-bar>button{min-height:44px;padding-inline:9px;font-size:.54rem}}
  @media(min-width:1024px){.package-intro,.package-sections{width:min(100%,1120px);max-width:100%;margin-inline:auto}}
  @media(prefers-reduced-motion:reduce){.package-intro-actions a,.booking-card-button{transition:none}.booking-card-button:hover{transform:none}}
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-package-gallery]").forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>(".package-photo");
    const counter = gallery.querySelector<HTMLElement>(".gallery-counter");
    const thumbnails = [...gallery.querySelectorAll<HTMLButtonElement>(".gallery-thumb")];
    let activeIndex = 0;

    const showPhoto = (nextIndex: number) => {
      if (!mainImage || thumbnails.length === 0) return;
      activeIndex = (nextIndex + thumbnails.length) % thumbnails.length;
      const selected = thumbnails[activeIndex];
      mainImage.src = selected.dataset.gallerySrc ?? "";
      mainImage.alt = selected.dataset.galleryAlt ?? "Mount Rinjani trekking landscape";
      if (selected.dataset.galleryWidth && selected.dataset.galleryHeight) {
        mainImage.width = Number(selected.dataset.galleryWidth);
        mainImage.height = Number(selected.dataset.galleryHeight);
      } else {
        mainImage.removeAttribute("width");
        mainImage.removeAttribute("height");
      }
      if (counter) counter.textContent = `${activeIndex + 1} / ${thumbnails.length}`;
      thumbnails.forEach((thumbnail, index) => {
        const isCurrent = index === activeIndex;
        thumbnail.classList.toggle("is-current", isCurrent);
        thumbnail.setAttribute("aria-pressed", String(isCurrent));
      });
    };

    thumbnails.forEach((thumbnail, index) => thumbnail.addEventListener("click", () => showPhoto(index)));
    gallery.querySelector<HTMLButtonElement>("[data-gallery-previous]")?.addEventListener("click", () => showPhoto(activeIndex - 1));
    gallery.querySelector<HTMLButtonElement>("[data-gallery-next]")?.addEventListener("click", () => showPhoto(activeIndex + 1));
  });
</script>
