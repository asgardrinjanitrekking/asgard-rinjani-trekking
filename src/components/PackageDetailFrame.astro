---
interface Detail {
  label: string;
  value: string;
}

import { getGalleryImageVariants } from "../data/galleryImageVariants";

interface Props {
  packageId?: string;
  title: string;
  heading: string;
  route: string;
  subtitle: string;
  note: string;
  heroImage: string;
  heroAlt: string;
  gallery: { src: string; alt: string }[];
  galleryTitle: string;
  galleryDescription: string;
  bookingHref: string;
  details: Detail[];
}

const { packageId: providedPackageId, title, heading, route, subtitle, note, heroImage, heroAlt, gallery, galleryTitle, galleryDescription, bookingHref, details } = Astro.props;
const packageIdsByImage: Record<string, string> = {
  "/asgard-rinjani-trekking/images/optimized/package-trn10.webp": "torean",
  "/asgard-rinjani-trekking/images/optimized/package-senaru09.webp": "senaru-crater-rim",
  "/asgard-rinjani-trekking/images/optimized/package-ss03.webp": "second-summit",
  "/asgard-rinjani-trekking/images/optimized/package-summit12.webp": "summit",
  "/asgard-rinjani-trekking/images/optimized/package-smbln05.webp": "sembalun-senaru",
  "/asgard-rinjani-trekking/images/optimized/package-trn03.webp": "4d3n-rinjani",
};
const packageId = providedPackageId ?? packageIdsByImage[heroImage] ?? "";
const detailValue = (label: string) => details.find((item) => item.label.toLowerCase() === label.toLowerCase())?.value ?? "Confirm with our team";
const photos = [{ src: heroImage, alt: heroAlt }, ...gallery.filter((photo) => photo.src !== heroImage)].map((photo) => ({ ...photo, ...getGalleryImageVariants(photo.src) }));
---

<main class="package-page">
  <div class="package-layout">
    <header class="package-intro">
        <p class="package-kicker">Mount Rinjani · Lombok, Indonesia</p>
        <h1>{heading}</h1>
        <p class="package-route">{route}</p>
        <p class="package-tagline">{subtitle}</p>
        <p class="package-note">{note}</p>
        <section class="package-gallery" data-package-gallery aria-label={galleryTitle}>
          <div class="gallery-heading"><h2>{galleryTitle}</h2><p>{galleryDescription}</p></div>
          <div class="gallery-stage">
            <figure class="package-photo-frame">
              <img class="package-photo" src={heroImage} alt={heroAlt} fetchpriority="high" decoding="async" />
              <figcaption>Asgard Rinjani Trekking <span>·</span> {detailValue("Duration")}</figcaption>
            </figure>
            <button class="gallery-arrow gallery-previous" type="button" data-gallery-previous aria-label="Previous package photo"><span aria-hidden="true">‹</span></button>
            <span class="gallery-counter" aria-live="polite">1 / {photos.length}</span>
            <button class="gallery-arrow gallery-next" type="button" data-gallery-next aria-label="Next package photo"><span aria-hidden="true">›</span></button>
          </div>
          <div class="gallery-thumbnails" role="group" aria-label="Choose a package photo">
            {photos.map((photo, index) => (
              <button class:list={["gallery-thumb", { "is-current": index === 0 }]} type="button" data-gallery-index={index} data-gallery-src={photo.full} data-gallery-alt={photo.alt} data-gallery-width={photo.fullWidth} data-gallery-height={photo.fullHeight} aria-label={`Show package photo ${index + 1}`} aria-pressed={index === 0}>
                <img src={photo.thumbnail} alt="" loading="lazy" decoding="async" width={photo.width} height={photo.height} />
              </button>
            ))}
          </div>
        </section>
        <nav class="package-intro-actions" aria-label="Package actions">
          <a class="package-action-primary" href="#booking-options">View tour options <span aria-hidden="true">↓</span></a>
        </nav>
    </header>

    <div class="package-sections">
      <slot />
    </div>

    <section class="package-booking" id="booking-options" aria-label="Package booking information">
      <div class="booking-card">
        <p class="booking-card-kicker">Your Rinjani journey</p>
        <h2>{title}</h2>
        <dl class="booking-facts">
          <div><dt>Duration</dt><dd>{detailValue("Duration")}</dd></div>
          <div><dt>Difficulty</dt><dd>{detailValue("Difficulty")}</dd></div>
          <div><dt>Starting point</dt><dd>{detailValue("Starting point")}</dd></div>
          <div><dt>Finishing point</dt><dd>{detailValue("Finishing point")}</dd></div>
          <div><dt>Maximum elevation</dt><dd>{detailValue("Maximum elevation")}</dd></div>
          <div><dt>Camping location</dt><dd>{detailValue("Camping location")}</dd></div>
          <div><dt>Group / private</dt><dd>Ask us about available group dates and private options.</dd></div>
        </dl>
        <section class="price-options" aria-label="Tour pricing options">
          <article class="price-option">
            <h3 class="price-option-heading price-option-heading-green">Trek Only</h3>
            <div class="price-option-body">
              <p class="price-option-description">Includes trekking transfers between the Senaru office and the trek starting and ending points. Pickup and drop-off from other locations in Lombok are not included.</p>
              <p class="price-value"><strong>Contact for pricing</strong><span>per person</span></p>
            </div>
          </article>
          <article class="price-option">
            <h3 class="price-option-heading price-option-heading-blue"><span>Trek + Transportation</span><em class="recommended-choice">A Recommended Choice</em></h3>
            <div class="price-option-body">
              <p class="price-option-description">Includes trekking transfers, plus pickup from your accommodation or chosen location in Lombok to our Senaru office and return drop-off after the trek.</p>
              <p class="price-value"><strong>Contact for pricing</strong><span>per person</span></p>
            </div>
          </article>
        </section>
        <button class="booking-card-button" type="button" data-booking-open data-booking-package={packageId} aria-haspopup="dialog" aria-controls="booking-modal">Check availability <span aria-hidden="true">↗</span></button>
        <p class="booking-card-note">Our team will confirm availability, route arrangements, and package details.</p>
      </div>
    </section>
  </div>
  <div class="mobile-booking-bar" aria-label="Quick booking">
    <p><strong>Contact for pricing</strong><span>per person</span></p>
    <button type="button" data-booking-open data-booking-package={packageId} aria-haspopup="dialog" aria-controls="booking-modal" aria-label={`Check availability for ${title}`}>Check availability <span aria-hidden="true">↗</span></button>
  </div>
</main>

<style>
  .package-page{min-height:100vh;background:radial-gradient(ellipse at 2% 0%,rgba(35,77,55,.28),transparent 38%),linear-gradient(180deg,#0b1711 0%,#09110d 44%,#080b09 100%);padding:calc(var(--header-h) + 28px) 0 24px}
  .package-layout{display:grid;grid-template-columns:minmax(0,1fr);gap:28px;align-items:start;width:min(1320px,calc(100% - 8vw));margin-inline:auto}
  .package-intro,.package-sections{width:min(70%,900px);max-width:100%;margin-inline:auto}
  .package-intro{min-width:0;padding:0 0 22px}
  .package-kicker,.booking-card-kicker{margin:0 0 12px;color:var(--gold-soft);font-size:.65rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase}
  .package-intro h1{max-width:900px;margin:0;color:#f5f0e5;font:500 clamp(2.7rem,5.1vw,5rem)/.98 var(--font-display);letter-spacing:-.025em;overflow-wrap:anywhere}
  .package-route{max-width:820px;margin:17px 0 7px;color:#e3dccd;font:400 clamp(1.25rem,2.2vw,1.85rem)/1.35 var(--font-display)}
  .package-tagline{max-width:780px;margin:8px 0 9px;color:#b1b9ae;font-size:.86rem;line-height:1.65}
  .package-note{max-width:780px;margin:0 0 23px;color:#a9b3aa;font-size:.85rem;line-height:1.65}
  .package-gallery{min-width:0}
