  .price-option-description{margin:0 0 5px;color:#b5beb2;font-size:.7rem;line-height:1.55;overflow-wrap:anywhere}
  .booking-card-button{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:54px;padding:14px 16px;border:0;background:linear-gradient(135deg,#16823b,#0d642c);color:#fff;font:700 .68rem/1.2 var(--font-body);letter-spacing:.11em;text-align:left;text-decoration:none;text-transform:uppercase;cursor:pointer;transition:filter .2s,transform .2s}
