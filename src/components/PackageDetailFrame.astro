  .gallery-heading h2{margin:0;color:#f0ebdf;font:500 1.55rem/1.1 var(--font-display)}
  .gallery-heading p{max-width:290px;margin:0;color:#a9b3aa;font-size:.69rem;line-height:1.45;text-align:right}
  .gallery-stage{position:relative;isolation:isolate}
