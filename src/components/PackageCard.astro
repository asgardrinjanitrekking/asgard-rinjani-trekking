---
interface Props {
  bookingId: string;
  title: string;
  duration: string;
  summary: string;
  route: string;
  difficulty: string;
  image: string;
  detailHref: string;
}

const { bookingId, title, duration, summary, route, difficulty, image, detailHref } = Astro.props;
---

<article class="card">
  <div class="media">
    <img src={image} alt={`${title} trekking landscape on ${route}`} loading="lazy" decoding="async" width="1200" height="800" />
    <span class="badge">{duration}</span>
  </div>
  <div class="body">
    <p class="route">{route}</p>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    <p class="meta">Difficulty <span aria-hidden="true">·</span> {difficulty}</p>
    <a class="btn btn-ghost btn-full" href={detailHref}>View package</a>
    <button class="btn btn-gold btn-full" type="button" data-booking-open data-booking-package={bookingId} aria-haspopup="dialog" aria-controls="booking-modal">Book this trek</button>
  </div>
</article>

<style>
  .card{background:var(--bg-card);border:1px solid var(--line);overflow:hidden;display:flex;flex-direction:column;min-height:100%;transition:transform .4s ease,border-color .4s ease,box-shadow .4s ease}
  .card:hover{transform:translateY(-5px);border-color:rgba(212,175,55,.5);box-shadow:0 24px 55px rgba(0,0,0,.32)}
  .media{position:relative;height:clamp(210px,20vw,270px);overflow:hidden;background:#171714}
  .media img{width:100%;height:100%;object-fit:cover;transition:transform .7s ease}
  .card:hover .media img{transform:scale(1.055)}
  .badge{position:absolute;left:16px;bottom:16px;background:rgba(7,7,7,.88);color:var(--gold-soft);border:1px solid rgba(212,175,55,.75);padding:7px 11px;font-size:.63rem;letter-spacing:.12em;text-transform:uppercase}
  .body{padding:25px 22px 22px;display:flex;flex-direction:column;gap:10px;flex:1}
  .route{margin:0;color:var(--gold);font-size:.67rem;letter-spacing:.13em;text-transform:uppercase}
  h3{margin:0;font-family:var(--font-display);font-size:1.85rem;font-weight:500;color:var(--cream);line-height:1.15}
  .summary{margin:0;color:var(--text-muted);flex:1;font-size:.94rem}
  .meta{margin:0 0 8px;color:#c1bbaf;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase}
  .card :is(a,button):focus-visible{outline:2px solid var(--gold-soft);outline-offset:3px}
  .card{position:relative;background:linear-gradient(155deg,rgba(24,22,17,.98),rgba(12,13,12,.98));border-color:rgba(212,175,55,.2);box-shadow:0 18px 50px rgba(0,0,0,.2)}
  .card:hover{transform:translateY(-7px);border-color:rgba(230,199,106,.65);box-shadow:0 28px 65px rgba(0,0,0,.4),0 0 28px rgba(212,175,55,.06)}
  .media{height:auto;aspect-ratio:1.42;isolation:isolate}
  .media::after{content:"";position:absolute;inset:35% 0 0;background:linear-gradient(180deg,transparent,rgba(5,6,5,.48));pointer-events:none}
  .media img{filter:saturate(.82) brightness(.88)}
  .card:hover .media img{filter:saturate(.98) brightness(.98)}
  .badge{z-index:1;left:18px;bottom:17px;padding:8px 12px;background:rgba(7,7,7,.9);backdrop-filter:blur(8px);border-color:rgba(230,199,106,.72);letter-spacing:.15em}
  .body{padding:25px 23px 23px;gap:12px}
  .route{font-size:.64rem;letter-spacing:.17em}
  h3{font-size:clamp(1.75rem,2vw,2.05rem);letter-spacing:-.01em}
  .summary{line-height:1.7;min-height:5em}
  .body .btn{min-height:48px;padding:13px 18px;font-size:.65rem;letter-spacing:.15em}
  .body .btn-ghost{border-color:rgba(212,175,55,.45);color:var(--gold-soft)}
  .body .btn-ghost:hover{border-color:var(--gold);background:rgba(212,175,55,.09)}
  @media(prefers-reduced-motion:reduce){.card,.media img{transition:none}.card:hover{transform:none}}
</style>
